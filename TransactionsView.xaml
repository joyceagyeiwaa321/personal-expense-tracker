<UserControl x:Class="FinancyApplication.TransactionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Display">

	<UserControl.Resources>
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="22"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TealButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="18,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00967A"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GhostButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="14,10"/>
		</Style>

		<Style x:Key="TabButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="22,12"/>
		</Style>

		<Style x:Key="InputBox" TargetType="TextBox">
			<Setter Property="Height" Value="36"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<Style x:Key="FilterCombo" TargetType="ComboBox">
			<Setter Property="Height" Value="36"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="MinWidth" Value="130"/>
		</Style>

		<!-- Chip-style category/type pill -->
		<Style x:Key="ChipBorder" TargetType="Border">
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
		</Style>
	</UserControl.Resources>

	<Grid>
		<!-- Main page content -->
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Width="1040"
                        HorizontalAlignment="Center"
                        Margin="0,32,0,32">

				<!-- HEADER -->
				<Grid Margin="0,0,0,18">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel>
						<TextBlock Text="Transactions"
                                   FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
						<TextBlock Text="Every income and expense, in one place."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
					</StackPanel>

					<StackPanel Grid.Column="1" Orientation="Horizontal">
						<Button Content="📥  Import CSV/Excel"
						        Background="Transparent"
						        BorderBrush="{DynamicResource AccentBrush}"
						        BorderThickness="1"
						        Foreground="{DynamicResource AccentBrush}"
						        FontSize="13"
						        FontWeight="SemiBold"
						        Padding="14,8"
						        Margin="0,0,10,0"
						        Cursor="Hand"
						        Click="ImportTransactions_Click"/>
						<Button Content="+  Add Transaction"
						        Style="{StaticResource TealButton}"
						        Click="AddTransaction_Click"/>
					</StackPanel>
				</Grid>

				<!-- TABS -->
				<Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="6,4" HorizontalAlignment="Left" Margin="0,0,0,18">
					<StackPanel Orientation="Horizontal">
						<Button x:Name="TabAll"
                                Content="All Transactions"
                                Style="{StaticResource TabButton}"
                                Foreground="#00B894"
                                Click="TabAll_Click"/>
						<Button x:Name="TabRecurring"
                                Content="Recurring"
                                Style="{StaticResource TabButton}"
                                Click="TabRecurring_Click"/>
					</StackPanel>
				</Border>

				<!-- ALL TRANSACTIONS PANEL -->
				<StackPanel x:Name="AllPanel">

					<!-- FILTER BAR -->
					<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<TextBox x:Name="SearchInput"
                                     Grid.Column="0"
                                     Style="{StaticResource InputBox}"
                                     Margin="0,0,10,0"
                                     TextChanged="Filter_Changed"
                                     ToolTip="Search description"/>

							<ComboBox x:Name="TypeFilter"
                                      Grid.Column="1"
                                      Style="{StaticResource FilterCombo}"
                                      Margin="0,0,10,0"
                                      SelectedIndex="0"
                                      SelectionChanged="Filter_Changed">
								<ComboBoxItem Content="All Types"/>
								<ComboBoxItem Content="Income"/>
								<ComboBoxItem Content="Expense"/>
							</ComboBox>

							<ComboBox x:Name="CategoryFilter"
                                      Grid.Column="2"
                                      Style="{StaticResource FilterCombo}"
                                      Margin="0,0,10,0"
                                      SelectionChanged="Filter_Changed"/>

							<ComboBox x:Name="AccountFilter"
                                      Grid.Column="3"
                                      Style="{StaticResource FilterCombo}"
                                      Margin="0,0,10,0"
                                      SelectionChanged="Filter_Changed"/>

							<ComboBox x:Name="PeriodFilter"
                                      Grid.Column="4"
                                      Style="{StaticResource FilterCombo}"
                                      SelectedIndex="0"
                                      Margin="0,0,10,0"
                                      SelectionChanged="Filter_Changed">
								<ComboBoxItem Content="This Month"/>
								<ComboBoxItem Content="Last Month"/>
								<ComboBoxItem Content="Last 3 Months"/>
								<ComboBoxItem Content="All Time"/>
							</ComboBox>

							<ComboBox x:Name="SortFilter"
                                      Grid.Column="5"
                                      Style="{StaticResource FilterCombo}"
                                      SelectedIndex="0"
                                      Margin="0,0,10,0"
                                      ToolTip="Sort order"
                                      SelectionChanged="Filter_Changed">
								<ComboBoxItem Content="Newest first"/>
								<ComboBoxItem Content="Oldest first"/>
								<ComboBoxItem Content="Highest amount"/>
								<ComboBoxItem Content="Lowest amount"/>
							</ComboBox>

							<Button Grid.Column="6"
                                    Content="Clear"
                                    Style="{StaticResource GhostButton}"
                                    Click="ClearFilters_Click"/>
						</Grid>
					</Border>

					<!-- TABLE -->
					<Border Style="{StaticResource CardStyle}" Padding="0">
						<StackPanel>
							<DataGrid x:Name="TransactionsGrid"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      BorderThickness="0"
                                      RowHeight="48"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      Background="{DynamicResource SurfaceBrush}"
                                      RowBackground="{DynamicResource SurfaceBrush}"
                                      AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                                      FontSize="13"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      ColumnHeaderHeight="42">

								<DataGrid.ColumnHeaderStyle>
									<Style TargetType="DataGridColumnHeader">
										<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
										<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
										<Setter Property="FontSize" Value="11"/>
										<Setter Property="FontWeight" Value="SemiBold"/>
										<Setter Property="HorizontalContentAlignment" Value="Left"/>
										<Setter Property="Padding" Value="14,0"/>
										<Setter Property="BorderBrush" Value="#E5E7EB"/>
										<Setter Property="BorderThickness" Value="0,0,0,1"/>
									</Style>
								</DataGrid.ColumnHeaderStyle>

								<DataGrid.CellStyle>
									<Style TargetType="DataGridCell">
										<Setter Property="BorderThickness" Value="0"/>
										<Setter Property="Padding" Value="14,0"/>
										<Setter Property="VerticalContentAlignment" Value="Center"/>
										<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
									</Style>
								</DataGrid.CellStyle>

								<DataGrid.Columns>
									<DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="120"/>
									<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>

									<DataGridTemplateColumn Header="Category" Width="170">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Border Style="{StaticResource ChipBorder}"
                                                        Background="{DynamicResource AccentMutedBrush}">
													<TextBlock Text="{Binding CategoryName}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="140"/>

									<DataGridTemplateColumn Header="Type" Width="100">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Border Style="{StaticResource ChipBorder}"
                                                        Background="{Binding TypeChipBg}">
													<TextBlock Text="{Binding Type}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding TypeChipFg}"/>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTextColumn Header="Amount" Binding="{Binding AmountDisplay}" Width="130">
										<DataGridTextColumn.ElementStyle>
											<Style TargetType="TextBlock">
												<Setter Property="HorizontalAlignment" Value="Right"/>
												<Setter Property="FontWeight" Value="SemiBold"/>
												<Setter Property="Foreground" Value="{Binding AmountColor}"/>
											</Style>
										</DataGridTextColumn.ElementStyle>
									</DataGridTextColumn>

									<DataGridTemplateColumn Header="" Width="110">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
													<Button Content="Edit"
                                                            Tag="{Binding TransactionID}"
                                                            Click="EditTransaction_Click"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#00796B"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            Padding="8,4"/>
													<Button Content="Delete"
                                                            Tag="{Binding TransactionID}"
                                                            Click="DeleteTransaction_Click"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#EF4444"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            Padding="8,4"/>
												</StackPanel>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>

							<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
								<TextBlock x:Name="FooterCount"
                                           Text="Showing 0 transactions"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
							</Border>
						</StackPanel>
					</Border>

					<!-- EMPTY-STATE PLACEHOLDER (shown when grid has no rows) -->
					<Border x:Name="EmptyState"
                            Style="{StaticResource CardStyle}"
                            Margin="0,16,0,0"
                            Visibility="Collapsed">
						<StackPanel HorizontalAlignment="Center" Margin="0,30">
							<TextBlock Text="No transactions match these filters."
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
							<TextBlock Text="Try clearing filters or add your first transaction."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- RECURRING PANEL -->
				<StackPanel x:Name="RecurringPanel" Visibility="Collapsed">

					<!-- Add Recurring action bar -->
					<Grid Margin="0,0,0,14">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Column="0"
						           Text="Scheduled income and expenses that repeat automatically."
						           FontSize="13"
						           Foreground="{DynamicResource TextSecondaryBrush}"
						           VerticalAlignment="Center"/>

						<Button Grid.Column="1"
						        Content="+  Add Recurring"
						        Style="{StaticResource TealButton}"
						        Click="AddRecurring_Click"/>
					</Grid>

					<ItemsControl x:Name="RecurringList">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<StackPanel>
											<TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
											<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
												<TextBlock Text="{Binding Frequency}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,0,12,0"/>
												<Border Style="{StaticResource ChipBorder}"
                                                        Background="{Binding StatusBg}">
													<TextBlock Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusFg}"/>
												</Border>
											</StackPanel>
										</StackPanel>

										<StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Margin="20,0">
											<TextBlock Text="{Binding AmountDisplay}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Right"/>
											<TextBlock Text="{Binding NextRunDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,4,0,0"
                                                       HorizontalAlignment="Right"/>
										</StackPanel>

										<StackPanel Grid.Column="2" Orientation="Horizontal">
											<Button Content="{Binding ToggleLabel}"
                                                    Tag="{Binding RecurringId}"
                                                    Click="RecurringToggle_Click"
                                                    Background="#F1F5F9"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Padding="12,8"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand"/>
											<Button Content="Delete"
                                                    Tag="{Binding RecurringId}"
                                                    Click="RecurringDelete_Click"
                                                    Background="#FEF2F2"
                                                    BorderThickness="0"
                                                    Foreground="#EF4444"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Padding="12,8"
                                                    Cursor="Hand"/>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!-- Recurring empty state -->
					<Border x:Name="RecurringEmpty"
                            Style="{StaticResource CardStyle}"
                            Visibility="Collapsed">
						<StackPanel HorizontalAlignment="Center" Margin="0,30">
							<TextBlock Text="No recurring transactions yet."
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
							<TextBlock Text="They'll show up here once your accounts have any scheduled."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<!-- Modal overlay — hosts the Add/Edit Transaction form inline (no popup window) -->
		<Grid x:Name="ModalHost" Visibility="Collapsed" Background="#80000000">
			<ContentControl x:Name="ModalContent"
			                HorizontalAlignment="Center"
			                VerticalAlignment="Center"
			                Margin="0,40"/>
		</Grid>
	</Grid>
</UserControl>