<Window x:Class="FinancyApplication.AdminProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Profile"
        Width="500"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        FontFamily="Segoe UI Variable Display"
        ResizeMode="NoResize">

	<Window.Resources>
		<Style x:Key="FormInput" TargetType="TextBox">
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#E2E8F0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Height" Value="36"/>
		</Style>

		<Style x:Key="FormLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#1F2937"/>
			<Setter Property="Margin" Value="0,12,0,6"/>
		</Style>

		<Style x:Key="TealButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Padding" Value="16,0"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00967A"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="bg" Property="Background" Value="#B0BEC5"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GrayButton" TargetType="Button">
			<Setter Property="Background" Value="#F1F5F9"/>
			<Setter Property="Foreground" Value="#64748B"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Padding" Value="16,0"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border Background="White">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="28">
				<!-- Header -->
				<TextBlock Text="My Profile"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>
				<TextBlock x:Name="UsernameDisplay"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,4,0,20"/>

				<!-- Avatar Section -->
				<Border Background="#F8FAFC"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,20">
					<StackPanel>
						<TextBlock Text="Avatar"
                                   Style="{StaticResource FormLabel}"/>
						<Border Width="80" Height="80"
                                CornerRadius="40"
                                Background="#00B894"
                                Margin="0,8,0,12"
                                HorizontalAlignment="Left">
							<TextBlock x:Name="AvatarInitial"
                                       Text="A"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
						</Border>
						<TextBlock Text="Avatar URL"
                                   Style="{StaticResource FormLabel}"
                                   Margin="0,12,0,6"/>
						<TextBox x:Name="AvatarUrlInput"
                                 Style="{StaticResource FormInput}"/>
						<TextBlock Text="Enter image URL (e.g., https://example.com/avatar.jpg)"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   Margin="0,4,0,0"/>
					</StackPanel>
				</Border>

				<!-- Personal Info Section -->
				<TextBlock Text="Personal Information"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Margin="0,12,0,12"/>

				<TextBlock Text="First Name"
                           Style="{StaticResource FormLabel}"/>
				<TextBox x:Name="FirstNameInput"
                         Style="{StaticResource FormInput}"/>

				<TextBlock Text="Last Name"
                           Style="{StaticResource FormLabel}"/>
				<TextBox x:Name="LastNameInput"
                         Style="{StaticResource FormInput}"/>

				<TextBlock Text="Phone Number"
                           Style="{StaticResource FormLabel}"/>
				<TextBox x:Name="PhoneInput"
                         Style="{StaticResource FormInput}"/>

				<!-- Account Info Section -->
				<TextBlock Text="Account Information"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Margin="0,20,0,12"/>

				<TextBlock Text="Email"
                           Style="{StaticResource FormLabel}"/>
				<TextBox x:Name="EmailDisplay"
                         Style="{StaticResource FormInput}"
                         IsReadOnly="True"
                         Background="#F8FAFC"/>

				<TextBlock Text="Role"
                           Style="{StaticResource FormLabel}"/>
				<TextBox x:Name="RoleDisplay"
                         Style="{StaticResource FormInput}"
                         IsReadOnly="True"
                         Background="#F8FAFC"/>

				<!-- Error Message -->
				<TextBlock x:Name="ErrorMessage"
                           Foreground="#DC2626"
                           FontSize="11"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

				<!-- Buttons -->
				<StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,28,0,0">
					<Button Content="Cancel"
                            Style="{StaticResource GrayButton}"
                            Width="110"
                            Margin="0,0,12,0"
                            Click="Cancel_Click"/>
					<Button Content="Save Changes"
                            Style="{StaticResource TealButton}"
                            Width="110"
                            Click="Save_Click"/>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Border>
</Window>
