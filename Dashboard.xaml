<Window x:Class="FinancyApplication.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard"
        Width="1180"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

	<Window.Resources>
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.12"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="NavButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#64748B"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Margin" Value="10,0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="IconButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="8,0"/>
		</Style>
	</Window.Resources>

	<DockPanel>

		<Border x:Name="NavBar" DockPanel.Dock="Top" Height="72" Background="White">
			<Grid Margin="120,12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

					<!-- LOGO -->
			<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
				<Border Width="46"
						Height="46"
						CornerRadius="11"
						Background="#00B894"
						Margin="0,0,10,0">
					<Image Source="pack://application:,,,/Images/logo.png"
							Width="36"
							Height="36"
							Stretch="Uniform"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"/>
				</Border>

				<TextBlock x:Name="LogoText"
							Text="ExpenseTrack"
							FontSize="17"
							FontWeight="Bold"
							Foreground="#1F2937"
							VerticalAlignment="Center"/>
			</StackPanel>

				<!-- NAV LINKS -->
				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
					<Button Content="Dashboard"
                            Style="{StaticResource NavButtonStyle}"
                            Foreground="#00B894"
                            FontWeight="Bold"
                            Click="NavDashboard_Click"/>

					<Button Content="Transactions"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavTransactions_Click"/>

					<Button Content="Budget"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavBudget_Click"/>

					<Button Content="Goals"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavGoals_Click"/>

					<Button Content="Reports"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavReports_Click"/>

					<Button Content="Group"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavGroups_Click"/>
				</StackPanel>

				<!-- RIGHT ICONS -->
				<StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

					<Button Style="{StaticResource IconButtonStyle}"
                            Click="ThemeToggle_Click">
						<TextBlock x:Name="ThemeIcon"
                                   FontFamily="Segoe Fluent Icons"
                                   Text="&#xE706;"
                                   FontSize="23"
                                   Foreground="#64748B"/>
					</Button>

					<Button Style="{StaticResource IconButtonStyle}"
        Click="NavProfile_Click">
						<Border Width="38" Height="38" CornerRadius="19"
            Background="#00B894" ClipToBounds="True">
							<Grid>
								<TextBlock x:Name="AvatarInitial"
                       Text="U"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
								<Image x:Name="NavAvatarImage"
                   Stretch="UniformToFill"
                   Visibility="Collapsed"/>
							</Grid>
						</Border>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Grid x:Name="MainContentHost">
		<ScrollViewer x:Name="DashboardContent" VerticalScrollBarVisibility="Auto">
			<StackPanel Width="880"
                        HorizontalAlignment="Center"
                        Margin="0,48,0,30">

				<UniformGrid Columns="4" Margin="0,0,0,34">

					<Border x:Name="BalanceCard" Style="{StaticResource CardStyle}" Margin="0,0,14,0">
						<StackPanel>
							<TextBlock Text="Total Balance" FontSize="12" Foreground="#64748B"/>
							<TextBlock x:Name="KpiBalance" FontSize="26" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,12,0,0"/>
							<TextBlock x:Name="KpiBalanceSub" FontSize="12" Foreground="#EF4444" Margin="0,10,0,0"/>
						</StackPanel>
					</Border>

					<Border x:Name="IncomeCard" Style="{StaticResource CardStyle}" Margin="7,0,7,0">
						<StackPanel>
							<TextBlock Text="Total Income" FontSize="12" Foreground="#64748B"/>
							<TextBlock x:Name="KpiIncome" FontSize="26" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,12,0,0"/>
							<TextBlock x:Name="KpiIncomeChange" FontSize="12" Foreground="#EF4444" Margin="0,10,0,0"/>
						</StackPanel>
					</Border>

					<Border x:Name="ExpenseCard" Style="{StaticResource CardStyle}" Margin="7,0,7,0">
						<StackPanel>
							<TextBlock Text="Total Expense" FontSize="12" Foreground="#64748B"/>
							<TextBlock x:Name="KpiExpenses" FontSize="26" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,12,0,0"/>
							<TextBlock x:Name="KpiExpensesChange" FontSize="12" Foreground="#EF4444" Margin="0,10,0,0"/>
						</StackPanel>
					</Border>

					<Border x:Name="SavingsCard" Style="{StaticResource CardStyle}" Margin="14,0,0,0">
						<StackPanel>
							<TextBlock Text="Savings Rate" FontSize="12" Foreground="#64748B"/>
							<TextBlock x:Name="KpiSavings" FontSize="26" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,12,0,0"/>
							<TextBlock x:Name="KpiSavingsChange" FontSize="12" Foreground="#EF4444" Margin="0,10,0,0"/>
						</StackPanel>
					</Border>

				</UniformGrid>

				<Grid Margin="0,0,0,18">
					<TextBlock x:Name="SpendingOverviewTitle"
                               Text="Spending Overview"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>

					<ComboBox x:Name="PeriodComboBox"
                              Width="112"
                              Height="28"
                              HorizontalAlignment="Right"
                              SelectedIndex="0"
                              FontSize="12"
                              Foreground="#64748B"
                              SelectionChanged="PeriodComboBox_SelectionChanged">
						<ComboBoxItem Content="This Month"/>
						<ComboBoxItem Content="Last Month"/>
						<ComboBoxItem Content="Last 6 Months"/>
					</ComboBox>
				</Grid>

				<Grid Margin="0,0,0,38">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1.05*"/>
						<ColumnDefinition Width="1*"/>
					</Grid.ColumnDefinitions>

					<Border x:Name="LineChartCard"
                            Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Height="280"
                            Margin="0,0,30,0">
						<StackPanel>
							<Grid>
								<TextBlock Text="Income vs Expense"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#1F2937"/>

								<TextBlock Text="Monthly trend"
                                           HorizontalAlignment="Right"
                                           FontSize="12"
                                           Foreground="#64748B"/>
							</Grid>

							<Canvas x:Name="IncomeExpenseCanvas"
                                    Height="205"
                                    Margin="0,12,0,0"/>

							<StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
								<TextBlock Text="━ Income"
                                           Foreground="#00B894"
                                           FontSize="12"
                                           Margin="10,0"/>

								<TextBlock Text="━ Expense"
                                           Foreground="#EF4444"
                                           FontSize="12"
                                           Margin="10,0"/>
							</StackPanel>
						</StackPanel>
					</Border>

					<Border x:Name="PieChartCard"
                            Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Height="280">
						<Grid>
							<StackPanel>
								<TextBlock Text="Expense Breakdown"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1F2937"/>

								<TextBlock Text="This month's spending by category"
                                           Foreground="#64748B"
                                           FontSize="13"
                                           Margin="0,5,0,5"/>

								<Canvas x:Name="ExpensePieCanvas"
                                        Width="250"
                                        Height="190"
                                        HorizontalAlignment="Left"/>
							</StackPanel>

							<StackPanel x:Name="PieLegendPanel"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,30,8,0"/>
						</Grid>
					</Border>
				</Grid>

				<Border x:Name="TransactionsCard"
                        Style="{StaticResource CardStyle}"
                        Width="720"
                        HorizontalAlignment="Left">

					<StackPanel>
						<TextBlock Text="Recent Transactions"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"/>

						<Button Content="View All"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#2563EB"
                                Padding="0"
                                Margin="0,12,0,12"
                                Click="ViewAllTransactions_Click"/>

						<StackPanel x:Name="NoTxPanel">
							<TextBlock Text="No transactions available"
                                       Foreground="#64748B"/>
						</StackPanel>

						<DataGrid x:Name="TxTable"
                                  Height="190"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="White"
                                  CanUserAddRows="False">

							<DataGrid.Columns>
								<DataGridTextColumn Header="Transaction" Binding="{Binding Description}" Width="*"/>
								<DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
								<DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="*"/>
								<DataGridTextColumn Header="Amount" Binding="{Binding AmountDisplay}" Width="*"/>
							</DataGrid.Columns>
						</DataGrid>
					</StackPanel>
				</Border>

				<Grid Margin="0,25,0,0">
					<TextBlock Text="© 2026 ExpenseTrack. All rights reserved."
                               Foreground="#64748B"
                               FontSize="12"/>

					<StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
						<TextBlock Text="Privacy Policy" Foreground="#64748B" Margin="0,0,25,0"/>
						<TextBlock Text="Terms of Use" Foreground="#64748B" Margin="0,0,25,0"/>
						<TextBlock Text="Contact" Foreground="#64748B"/>
					</StackPanel>
				</Grid>

			</StackPanel>
		</ScrollViewer>

		<!-- Embedded profile lives here; created on demand by NavProfile_Click -->
		<ContentControl x:Name="ProfileHost" Visibility="Collapsed"/>
		</Grid>
	</DockPanel>
</Window>