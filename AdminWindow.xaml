<Window x:Class="FinancyApplication.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Financy — Admin Console"
        Width="1240"
        Height="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Display">

	<Window.Resources>

		<!-- ───────────────────────── BASE COLORS / CARD ───────────────────────── -->
		<SolidColorBrush x:Key="TealBrush" Color="#00B894"/>
		<SolidColorBrush x:Key="TealDarkBrush" Color="#00796B"/>
		<SolidColorBrush x:Key="TealTintBrush" Color="#E0F2F1"/>
		<SolidColorBrush x:Key="BorderBrushSoft" Color="#EEF2F6"/>

		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="Padding" Value="22"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ───────────────────────── BUTTONS (unified palette) ─────────────── -->

		<!-- Primary teal -->
		<Style x:Key="TealButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="38"/>
			<Setter Property="Padding" Value="18,0"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00967A"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="bg" Property="Background" Value="#B0BEC5"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Secondary outline -->
		<Style x:Key="GhostButton" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
			<Setter Property="Foreground" Value="#00796B"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="38"/>
			<Setter Property="Padding" Value="18,0"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#B2DFDB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#E0F2F1"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Inline grid action (compact) -->
		<Style x:Key="RowActionTeal" TargetType="Button">
			<Setter Property="Background" Value="#E0F2F1"/>
			<Setter Property="Foreground" Value="#00695C"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="Margin" Value="0,0,6,0"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#B2DFDB"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
								<Setter Property="Foreground" Value="#94A3B8"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Danger row action (delete only) -->
		<Style x:Key="RowActionDanger" TargetType="Button" BasedOn="{StaticResource RowActionTeal}">
			<Setter Property="Background" Value="#FEE2E2"/>
			<Setter Property="Foreground" Value="#B91C1C"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#FECACA"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
								<Setter Property="Foreground" Value="#94A3B8"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Sidebar nav item -->
		<Style x:Key="NavItem" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="42"/>
			<Setter Property="Margin" Value="12,2"/>
			<Setter Property="Padding" Value="14,0"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8"/>
							<!-- Active accent bar (toggled by changing the button's Tag) -->
							<Border x:Name="accent" Width="3" HorizontalAlignment="Left"
                                    Background="#00B894" CornerRadius="2"
                                    Margin="-12,8,0,8"
                                    Visibility="Collapsed"/>
							<ContentPresenter x:Name="content"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
							</Trigger>
							<Trigger Property="Tag" Value="active">
								<Setter TargetName="bg" Property="Background" Value="#E0F2F1"/>
								<Setter TargetName="accent" Property="Visibility" Value="Visible"/>
								<Setter Property="Foreground" Value="#00796B"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Subtle "danger" sidebar item (Logout) -->
		<Style x:Key="NavItemDanger" TargetType="Button" BasedOn="{StaticResource NavItem}">
			<Setter Property="Foreground" Value="#B91C1C"/>
		</Style>

		<Style x:Key="ChipBorder" TargetType="Border">
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Padding" Value="10,3"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
		</Style>
	</Window.Resources>

	<DockPanel>

		<!-- ═══════════════════════════ LEFT SIDEBAR ═══════════════════════════ -->
		<Border DockPanel.Dock="Left" Width="230" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
			<DockPanel>

				<!-- Logo block -->
				<Border DockPanel.Dock="Top" Padding="20,22,20,18">
					<StackPanel Orientation="Horizontal">
						<Border Width="38" Height="38" CornerRadius="10" Background="#00B894" Margin="0,0,10,0">
							<Image Source="pack://application:,,,/Images/logo.png"
                                   Width="28" Height="28" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<StackPanel VerticalAlignment="Center">
							<TextBlock Text="Financy" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
							<TextBlock Text="Admin Console" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Logout pinned to bottom -->
				<Button x:Name="NavLogout"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource NavItemDanger}"
                        Margin="12,2,12,16"
                        Click="Logout_Click">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
						<TextBlock Text="Logout" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>

				<!-- Section label -->
				<TextBlock DockPanel.Dock="Top" Text="MENU"
                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="26,8,0,8"/>

				<!-- Nav items -->
				<StackPanel DockPanel.Dock="Top">
					<Button x:Name="NavUsers" Style="{StaticResource NavItem}"
                            Tag="active" Click="NavUsers_Click">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
							<TextBlock Text="Users" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button x:Name="NavReports" Style="{StaticResource NavItem}"
                            Click="NavReports_Click">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
							<TextBlock Text="Export Report" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>

			</DockPanel>
		</Border>

		<!-- ═══════════════════════════ MAIN AREA ═══════════════════════════ -->
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Top bar -->
			<Border Grid.Row="0" Background="Transparent" Padding="36,20,36,12">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" VerticalAlignment="Center">
						<TextBlock x:Name="AdminGreeting"
                                   Text="Hello, admin"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
						<TextBlock Text="Welcome back to your admin console."
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
					</StackPanel>

					<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
						<Button x:Name="AdminAvatarButton"
                                Width="40" Height="40"
                                Click="AdminAvatar_Click"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Grid>
										<Border x:Name="bg" Width="40" Height="40" CornerRadius="20"
                                                Background="#00B894">
											<TextBlock x:Name="AdminInitial"
                                                       Text="A"
                                                       Foreground="White"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
										</Border>
										<Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
											<Image x:Name="AdminNavImage" Stretch="UniformToFill" Visibility="Collapsed"/>
										</Border>
									</Grid>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="bg" Property="Background" Value="#00967A"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<!-- Body container with three swappable views -->
			<Grid Grid.Row="1">

				<!-- ─────────────── USERS VIEW ─────────────── -->
				<ScrollViewer x:Name="UsersView"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Visible">
					<StackPanel Margin="36,4,36,32">

						<!-- Page sub-header + actions -->
						<Grid Margin="0,0,0,18">
							<StackPanel>
								<TextBlock Text="Access Management"
                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
								<TextBlock Text="Manage users, roles, and system-wide statistics."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
							</StackPanel>

							<StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
								<Button Content="Refresh"
                                        Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,0"
                                        Click="Refresh_Click"/>
								<Button Content="+  Create User"
                                        Style="{StaticResource TealButton}"
                                        Click="CreateUser_Click"/>
							</StackPanel>
						</Grid>

						<!-- KPI STRIP -->
						<UniformGrid Columns="5" Margin="0,0,0,22">
							<!-- Total Users -->
							<Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="18">
								<StackPanel Orientation="Horizontal">
									<Border Width="42" Height="42" CornerRadius="11" Background="#0F172A" Margin="0,0,12,0">
										<TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="White" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock x:Name="KpiUsers" Text="0"
                                                   FontSize="20" FontWeight="Bold" Foreground="#00B894"/>
										<TextBlock Text="Total Users" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
									</StackPanel>
								</StackPanel>
							</Border>
							<!-- Active -->
							<Border Style="{StaticResource CardStyle}" Margin="3,0,3,0" Padding="18">
								<StackPanel Orientation="Horizontal">
									<Border Width="42" Height="42" CornerRadius="11" Background="#0F172A" Margin="0,0,12,0">
										<TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="White" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock x:Name="KpiActive" Text="0"
                                                   FontSize="20" FontWeight="Bold" Foreground="#00B894"/>
										<TextBlock Text="Active Users" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
									</StackPanel>
								</StackPanel>
							</Border>
							<!-- Inactive -->
							<Border Style="{StaticResource CardStyle}" Margin="3,0,3,0" Padding="18">
								<StackPanel Orientation="Horizontal">
									<Border Width="42" Height="42" CornerRadius="11" Background="#0F172A" Margin="0,0,12,0">
										<TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="White" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock x:Name="KpiInactive" Text="0"
                                                   FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
										<TextBlock Text="Inactive" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
									</StackPanel>
								</StackPanel>
							</Border>
							<!-- Accounts -->
							<Border Style="{StaticResource CardStyle}" Margin="3,0,3,0" Padding="18">
								<StackPanel Orientation="Horizontal">
									<Border Width="42" Height="42" CornerRadius="11" Background="#0F172A" Margin="0,0,12,0">
										<TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="White" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock x:Name="KpiAccounts" Text="0"
                                                   FontSize="20" FontWeight="Bold" Foreground="#00B894"/>
										<TextBlock Text="Accounts" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
									</StackPanel>
								</StackPanel>
							</Border>
							<!-- Transactions -->
							<Border Style="{StaticResource CardStyle}" Margin="6,0,0,0" Padding="18">
								<StackPanel Orientation="Horizontal">
									<Border Width="42" Height="42" CornerRadius="11" Background="#0F172A" Margin="0,0,12,0">
										<TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="White" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock x:Name="KpiTransactions" Text="0"
                                                   FontSize="20" FontWeight="Bold" Foreground="#00B894"/>
										<TextBlock Text="Transactions" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
									</StackPanel>
								</StackPanel>
							</Border>
						</UniformGrid>

						<!-- USERS CARD -->
						<Border Style="{StaticResource CardStyle}">
							<StackPanel>
								<Grid Margin="0,0,0,14">
									<StackPanel>
										<TextBlock Text="Users"
                                                   FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
										<TextBlock x:Name="UsersSubtitle"
                                                   Text="Everyone registered on Financy."
                                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
									</StackPanel>

									<StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
										<Border Background="#F8FAFC"
                                                CornerRadius="8"
                                                BorderBrush="#EEF2F6"
                                                BorderThickness="1"
                                                Padding="10,0"
                                                Margin="0,0,8,0"
                                                Height="36">
											<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
												<TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
												<TextBox x:Name="SearchBox"
                                                         Width="220"
                                                         VerticalAlignment="Center"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         FontSize="12"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         TextChanged="SearchBox_TextChanged"/>
											</StackPanel>
										</Border>

										<ComboBox x:Name="RoleFilter"
                                                  Height="36"
                                                  MinWidth="130"
                                                  FontSize="12"
                                                  VerticalContentAlignment="Center"
                                                  Padding="8,0"
                                                  SelectionChanged="RoleFilter_SelectionChanged">
											<ComboBoxItem Content="All roles" IsSelected="True"/>
											<ComboBoxItem Content="Admins only"/>
											<ComboBoxItem Content="Users only"/>
										</ComboBox>
									</StackPanel>
								</Grid>

								<DataGrid x:Name="UsersGrid"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          BorderThickness="0"
                                          Background="{DynamicResource SurfaceBrush}"
                                          RowBackground="{DynamicResource SurfaceBrush}"
                                          AlternatingRowBackground="#FAFBFC"
                                          CanUserAddRows="False"
                                          CanUserResizeRows="False"
                                          CanUserSortColumns="True"
                                          IsReadOnly="True"
                                          Height="360"
                                          RowHeight="46"
                                          ColumnHeaderHeight="40"
                                          FontSize="13"
                                          Foreground="{DynamicResource TextPrimaryBrush}">
									<DataGrid.ColumnHeaderStyle>
										<Style TargetType="DataGridColumnHeader">
											<Setter Property="Background" Value="#F8FAFC"/>
											<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
											<Setter Property="FontSize" Value="11"/>
											<Setter Property="FontWeight" Value="SemiBold"/>
											<Setter Property="HorizontalContentAlignment" Value="Left"/>
											<Setter Property="Padding" Value="14,0"/>
											<Setter Property="BorderBrush" Value="#EEF2F6"/>
											<Setter Property="BorderThickness" Value="0,0,0,1"/>
										</Style>
									</DataGrid.ColumnHeaderStyle>
									<DataGrid.CellStyle>
										<Style TargetType="DataGridCell">
											<Setter Property="BorderThickness" Value="0"/>
											<Setter Property="Padding" Value="14,0"/>
											<Setter Property="VerticalContentAlignment" Value="Center"/>
											<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
										</Style>
									</DataGrid.CellStyle>
									<DataGrid.Columns>
										<DataGridTextColumn Header="Username"
                                                            Binding="{Binding Username}"
                                                            Width="*"/>
										<DataGridTextColumn Header="Email"
                                                            Binding="{Binding Email}"
                                                            Width="1.6*"/>
										<DataGridTextColumn Header="Role"
                                                            Binding="{Binding Role}"
                                                            Width="0.8*"/>
										<DataGridTextColumn Header="Status"
                                                            Binding="{Binding Status}"
                                                            Width="0.8*"/>
										<DataGridTextColumn Header="Created"
                                                            Binding="{Binding CreatedDisplay}"
                                                            Width="*"/>
										<DataGridTemplateColumn Header="Actions" Width="2.4*">
											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate>
													<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
														<Button Content="{Binding StatusActionLabel}"
                                                                Style="{StaticResource RowActionTeal}"
                                                                Tag="{Binding UserID}"
                                                                IsEnabled="{Binding CanEdit}"
                                                                Click="ToggleStatus_Click"/>
														<Button Content="{Binding RoleActionLabel}"
                                                                Style="{StaticResource RowActionTeal}"
                                                                Tag="{Binding UserID}"
                                                                IsEnabled="{Binding CanEdit}"
                                                                Click="ToggleRole_Click"/>
														<Button Content="Send Reset"
                                                                Style="{StaticResource RowActionTeal}"
                                                                Tag="{Binding UserID}"
                                                                Click="SendReset_Click"/>
														<Button Content="Delete"
                                                                Style="{StaticResource RowActionDanger}"
                                                                Tag="{Binding UserID}"
                                                                IsEnabled="{Binding CanEdit}"
                                                                Click="DeleteUser_Click"/>
													</StackPanel>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>
									</DataGrid.Columns>
								</DataGrid>

								<TextBlock x:Name="UsersEmpty"
                                           Text="No users match the current filters."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,4"
                                           Visibility="Collapsed"/>
							</StackPanel>
						</Border>

						<TextBlock Text="© 2026 Financy Application — Admin Console"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,18,0,0"/>
					</StackPanel>
				</ScrollViewer> 

				<!-- ─────────────── CREATE USER VIEW ─────────────── -->
				<ScrollViewer x:Name="CreateUserView"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
					<StackPanel Width="560"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,32">

						<Grid Margin="0,0,0,18">
							<Button Content="← Back to Users"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Foreground="#00B894"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="BackToUsers_Click"
                                    Padding="0"/>
						</Grid>

						<Border Style="{StaticResource CardStyle}" Padding="32">
							<StackPanel>
								<TextBlock Text="Create New User"
                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
								<TextBlock Text="Fill in the details to create a new user account."
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,22"/>

								<TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
								<TextBox x:Name="NewUsernameInput"
                                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                         Padding="10,8" FontSize="13" Height="38" Margin="0,0,0,14"/>

								<TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
								<TextBox x:Name="NewEmailInput"
                                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                         Padding="10,8" FontSize="13" Height="38" Margin="0,0,0,14"/>

								<Grid Margin="0,0,0,14">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="14"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
										<PasswordBox x:Name="NewPasswordInput"
                                                     Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                     Padding="10,8" FontSize="13" Height="38"/>
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Text="Confirm Password" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
										<PasswordBox x:Name="NewConfirmPasswordInput"
                                                     Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                     Padding="10,8" FontSize="13" Height="38"/>
									</StackPanel>
								</Grid>

								<TextBlock Text="Role" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
								<ComboBox x:Name="NewRoleComboBox"
                                          Height="38"
                                          FontSize="13"
                                          VerticalContentAlignment="Center"
                                          Padding="8,0"
                                          Margin="0,0,0,4">
									<ComboBoxItem Content="User" IsSelected="True"/>
									<ComboBoxItem Content="Admin"/>
								</ComboBox>

								<TextBlock x:Name="CreateUserError"
                                           Foreground="#DC2626" FontSize="12"
                                           Margin="0,12,0,0" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>

								<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
									<Button Content="Cancel"
                                            Style="{StaticResource GhostButton}"
                                            Width="110" Margin="0,0,8,0"
                                            Click="BackToUsers_Click"/>
									<Button Content="Create User"
                                            Style="{StaticResource TealButton}"
                                            Width="140"
                                            Click="CreateUserSubmit_Click"/>
								</StackPanel>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Grid>
	</DockPanel>
</Window>
