<Window x:Class="FinancyApplication.BudgetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Budget"
        Width="420"
        Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8">

	<Window.Resources>
		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#374151"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
		</Style>

		<Style x:Key="GreenButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="16,0">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00967A"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border Background="White" CornerRadius="10" Margin="16">
		<Border.Effect>
			<DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10"/>
		</Border.Effect>

		<StackPanel Margin="28,24">

			<TextBlock x:Name="DialogTitle"
                       Text="Add New Budget"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#1F2937"
                       Margin="0,0,0,20"/>

			<!-- Category -->
			<TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
			<ComboBox x:Name="CategoryComboBox"
                      Height="36" FontSize="13"
                      Margin="0,0,0,16"/>

			<!-- Limit Amount -->
			<TextBlock Text="Monthly Limit (€)" Style="{StaticResource FieldLabel}"/>
			<TextBox x:Name="LimitInput"
                     Height="36"
                     FontSize="13"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#DDE3E7"
                     BorderThickness="1.5"
                     Margin="0,0,0,24">
				<TextBox.Style>
					<Style TargetType="TextBox">
						<Style.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="#00B894"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</TextBox.Style>
			</TextBox>

			<!-- Buttons -->
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="12"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0"
                        Content="Cancel"
                        Height="40"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderThickness="0"
                        FontSize="13"
                        Cursor="Hand"
                        Click="Cancel_Click">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="bg" Property="Background" Value="#E5E7EB"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>

				<Button Grid.Column="2"
                        x:Name="SaveButton"
                        Content="Save Budget"
                        Style="{StaticResource GreenButton}"
                        Click="Save_Click"/>
			</Grid>

		</StackPanel>
	</Border>
</Window>
