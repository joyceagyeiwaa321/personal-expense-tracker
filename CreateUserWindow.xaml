<Window x:Class="FinancyApplication.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New User"
        Width="420"
        Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Display"
        ResizeMode="NoResize">

	<Window.Resources>
		<Style x:Key="FormInput" TargetType="TextBox">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="#E2E8F0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Height" Value="36"/>
		</Style>

		<Style x:Key="FormLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Margin" Value="0,12,0,6"/>
		</Style>

		<Style x:Key="TealButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Padding" Value="16,0"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00967A"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="bg" Property="Background" Value="#B0BEC5"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GrayButton" TargetType="Button">
			<Setter Property="Background" Value="#F1F5F9"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Padding" Value="16,0"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border Background="{DynamicResource SurfaceBrush}">
		<StackPanel Margin="24">
			<!-- Header -->
			<TextBlock Text="Create New User"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
			<TextBlock Text="Fill in the details to create a new user account"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,6,0,16"/>

			<!-- Form -->
			<TextBlock Text="Username"
                       Style="{StaticResource FormLabel}"/>
			<TextBox x:Name="UsernameInput"
                     Style="{StaticResource FormInput}"/>

			<TextBlock Text="Email Address"
                       Style="{StaticResource FormLabel}"/>
			<TextBox x:Name="EmailInput"
                     Style="{StaticResource FormInput}"/>

			<TextBlock Text="Password"
                       Style="{StaticResource FormLabel}"/>
			<PasswordBox x:Name="PasswordInput"
                         Background="{DynamicResource SurfaceBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Padding="10,8"
                         FontSize="12"
                         Height="36"/>

			<TextBlock Text="Confirm Password"
                       Style="{StaticResource FormLabel}"/>
			<PasswordBox x:Name="ConfirmPasswordInput"
                         Background="{DynamicResource SurfaceBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Padding="10,8"
                         FontSize="12"
                         Height="36"/>

			<TextBlock Text="Role"
                       Style="{StaticResource FormLabel}"/>
			<ComboBox x:Name="RoleComboBox"
                      Height="36"
                      FontSize="12"
                      VerticalContentAlignment="Center"
                      Padding="8,0">
				<ComboBoxItem Content="User" IsSelected="True"/>
				<ComboBoxItem Content="Admin"/>
			</ComboBox>

			<TextBlock x:Name="ErrorMessage"
                       Foreground="#DC2626"
                       FontSize="11"
                       Margin="0,16,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>

			<!-- Buttons -->
			<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
				<Button Content="Cancel"
                        Style="{StaticResource GrayButton}"
                        Width="100"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
				<Button Content="Create"
                        Style="{StaticResource TealButton}"
                        Width="100"
                        Click="Create_Click"/>
			</StackPanel>
		</StackPanel>
	</Border>
</Window>
