<UserControl x:Class="FinancyApplication.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F8F5">

	<UserControl.Resources>
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#1A5C38" Opacity="0.05" Direction="270"/>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
			<Setter Property="Padding" Value="20,16"/>
		</Style>
		<Style x:Key="LinkBtn" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#2ECC71"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextDecorations="Underline"/>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="PrimaryBtn" TargetType="Button">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#1A5C38"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Padding" Value="18,0"/>
			<Setter Property="FontFamily" Value="Segoe UI Semibold"/>
			<Setter Property="FontSize" Value="12.5"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="b" Property="Background" Value="#F0FFF6"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid>
		<ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,18,24,24">
			<StackPanel>

				<!-- Welcome Banner -->
				<Border CornerRadius="14" Height="90" ClipToBounds="True" Margin="0,0,0,16">
					<Border.Background>
						<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
							<GradientStop Color="#1A5C38" Offset="0"/>
							<GradientStop Color="#27AE60" Offset="1"/>
						</LinearGradientBrush>
					</Border.Background>
					<Grid Margin="24,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<TextBlock x:Name="WelcomeText" Text="Welcome back 👋"
                                       Foreground="White" FontFamily="Segoe UI Semibold" FontSize="17"/>
							<TextBlock x:Name="WelcomeSubText" Text="Here's your financial summary."
                                       Foreground="#CCFFE6" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,0"/>
						</StackPanel>
						<Button Grid.Column="1" Style="{StaticResource PrimaryBtn}"
                                VerticalAlignment="Center" Click="AddTransaction_Click">
							+ Add Transaction
						</Button>
					</Grid>
				</Border>

				<!-- 4 KPI Cards -->
				<Grid Margin="0,0,0,16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,8,0">
						<StackPanel>
							<TextBlock Text="Total Balance" Foreground="#8FAF9F" FontFamily="Segoe UI" FontSize="11.5" Margin="0,0,0,6"/>
							<TextBlock x:Name="KpiBalance" Text="€0.00" Foreground="#1A2E22" FontFamily="Segoe UI Black" FontSize="22"/>
							<TextBlock x:Name="KpiBalanceSub" Text="Across all accounts" Foreground="#8FAF9F" FontFamily="Segoe UI" FontSize="11" Margin="0,4,0,0"/>
						</StackPanel>
					</Border>

					<Border Grid.Column="1" Style="{StaticResource KpiCard}" Margin="4,0">
						<StackPanel>
							<TextBlock Text="Total Income" Foreground="#8FAF9F" FontFamily="Segoe UI" FontSize="11.5" Margin="0,0,0,6"/>
							<TextBlock x:Name="KpiIncome" Text="€0.00" Foreground="#2ECC71" FontFamily="Segoe UI Black" FontSize="22"/>
							<TextBlock x:Name="KpiIncomeChange" Text="This month" Foreground="#8FAF9F" FontFamily="Segoe UI" FontSize="11" Margin="0,4,0,0"/>
						</StackPanel>
					</Border>

					<Border Grid.Column="2" Style="{StaticResource KpiCard}" Margin="4,0">
						<StackPanel>
							<TextBlock Text="Total Expense" Foreground="#8FAF9F" FontFamily="Segoe UI" FontSize="11.5" Margin="0,0,0,6"/>
							<TextBlock x:Name="KpiExpenses" Text="€0.00" Foreground="#FF6B6B" FontFamily="Segoe UI Black" FontSize="22"/>
							<TextBlock x:Name="KpiExpensesChange" Text="This month" Foreground="#8FAF9F" FontFamily="Segoe UI" FontSize="11" Margin="0,4,0,0"/>
						</StackPanel>
					</Border>

					<Border Grid.Column="3" Style="{StaticResource KpiCard}" Margin="8,0,0,0">
						<StackPanel>
							<TextBlock Text="Savings Rate" Foreground="#8FAF9F" FontFamily="Segoe UI" FontSize="11.5" Margin="0,0,0,6"/>
							<TextBlock x:Name="KpiSavings" Text="0%" Foreground="#1A5C38" FontFamily="Segoe UI Black" FontSize="22"/>
							<TextBlock Text="Of total income" Foreground="#8FAF9F" FontFamily="Segoe UI" FontSize="11" Margin="0,4,0,0"/>
						</StackPanel>
					</Border>
				</Grid>

				<!-- Spending Overview header -->
				<Grid Margin="0,0,0,16">
					<TextBlock Text="Spending Overview" FontFamily="Segoe UI Semibold"
                               FontSize="15" Foreground="#1A2E22" VerticalAlignment="Center"/>
					<Border HorizontalAlignment="Right" CornerRadius="8"
                            BorderBrush="#E0EDE6" BorderThickness="1" Padding="10,4">
						<TextBlock x:Name="MonthLabel" Text="May 2026 ▾"
                                   FontFamily="Segoe UI" FontSize="11.5" Foreground="#4A6558"/>
					</Border>
				</Grid>

				<!-- Charts Row -->
				<Grid Height="240" Margin="0,0,0,16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Margin="0,0,0,8">
								<TextBlock Text="Income vs Expense" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="#1A2E22"/>
								<TextBlock Text="Monthly trend" HorizontalAlignment="Right" FontFamily="Segoe UI" FontSize="11" Foreground="#8FAF9F" VerticalAlignment="Center"/>
							</Grid>
							<Border Grid.Row="1" Background="#F4F8F5" CornerRadius="8">
								<TextBlock Text="📈  Install OxyPlot.Wpf via NuGet for charts"
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#8FAF9F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
							</Border>
							<StackPanel Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,6,0,0">
								<Border Width="16" Height="3" Background="#2ECC71"
                                        VerticalAlignment="Center" CornerRadius="2" Margin="0,0,5,0"/>
								<TextBlock Text="Income" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#4A6558" VerticalAlignment="Center" Margin="0,0,20,0"/>
								<Border Width="16" Height="3" Background="#FF6B6B"
                                        VerticalAlignment="Center" CornerRadius="2" Margin="0,0,5,0"/>
								<TextBlock Text="Expense" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#4A6558" VerticalAlignment="Center"/>
							</StackPanel>
						</Grid>
					</Border>

					<Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="16">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>
							<StackPanel Grid.Row="0" Margin="0,0,0,8">
								<TextBlock Text="Expense Breakdown" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="#1A2E22"/>
								<TextBlock Text="This month's spending by category" FontFamily="Segoe UI" FontSize="11" Foreground="#8FAF9F"/>
							</StackPanel>
							<Border Grid.Row="1" Background="#F4F8F5" CornerRadius="8">
								<TextBlock Text="🥧  Install OxyPlot.Wpf via NuGet for charts"
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#8FAF9F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
							</Border>
						</Grid>
					</Border>
				</Grid>

				<!-- Recent Transactions Table -->
				<Border Style="{StaticResource Card}" Padding="20,16">
					<StackPanel>
						<Grid Margin="0,0,0,10">
							<TextBlock Text="Recent Transactions" FontFamily="Segoe UI Semibold"
                                       FontSize="14" Foreground="#1A2E22" VerticalAlignment="Center"/>
							<Button Style="{StaticResource LinkBtn}"
                                    HorizontalAlignment="Left" Margin="172,0,0,0"
                                    Content="View All" VerticalAlignment="Center"
                                    Click="ViewAllTransactions_Click"/>
						</Grid>

						<Border BorderBrush="#E0EDE6" BorderThickness="0,1,0,1" Padding="0,8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="180"/>
									<ColumnDefinition Width="140"/>
									<ColumnDefinition Width="110"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Transaction" Foreground="#8FAF9F" FontFamily="Segoe UI Semibold" FontSize="11.5"/>
								<TextBlock Grid.Column="1" Text="Category" Foreground="#8FAF9F" FontFamily="Segoe UI Semibold" FontSize="11.5"/>
								<TextBlock Grid.Column="2" Text="Date" Foreground="#8FAF9F" FontFamily="Segoe UI Semibold" FontSize="11.5"/>
								<TextBlock Grid.Column="3" Text="Amount" Foreground="#8FAF9F" FontFamily="Segoe UI Semibold" FontSize="11.5" HorizontalAlignment="Right"/>
							</Grid>
						</Border>

						<ItemsControl x:Name="TxTable">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border BorderBrush="#F0F6F2" BorderThickness="0,0,0,1" Padding="0,10">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="180"/>
												<ColumnDefinition Width="140"/>
												<ColumnDefinition Width="110"/>
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="{Binding Description}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#1A2E22" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="1" Text="{Binding Category}" FontFamily="Segoe UI" FontSize="12" Foreground="#4A6558" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding DateDisplay}" FontFamily="Segoe UI" FontSize="12" Foreground="#8FAF9F" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="3" Text="{Binding AmountDisplay}" FontFamily="Segoe UI Semibold" FontSize="12.5"
                                                       Foreground="{Binding AmountColor}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<StackPanel x:Name="NoTxPanel" Visibility="Collapsed"
                                    HorizontalAlignment="Center" Margin="0,20">
							<TextBlock Text="💸" FontSize="32" HorizontalAlignment="Center"/>
							<TextBlock Text="No transactions this month"
                                       Foreground="#8FAF9F" FontFamily="Segoe UI" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
						</StackPanel>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<!-- Modal overlay for Add Transaction -->
		<Grid x:Name="ModalHost" Visibility="Collapsed" Background="#88000000">
			<Border MaxWidth="520" MaxHeight="560"
                    Background="White" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
				<ContentControl x:Name="ModalContent"/>
			</Border>
		</Grid>
	</Grid>
</UserControl>
