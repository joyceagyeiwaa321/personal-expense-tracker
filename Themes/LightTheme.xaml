<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / page background -->
    <SolidColorBrush x:Key="BackgroundBrush"        Color="#F4F6F8"/>
    <!-- Top nav bar -->
    <SolidColorBrush x:Key="NavBarBrush"            Color="#FFFFFF"/>
    <!-- Cards / panels -->
    <SolidColorBrush x:Key="SurfaceBrush"           Color="#FFFFFF"/>
    <!-- Slightly elevated surfaces (e.g. table rows hover, secondary cards) -->
    <SolidColorBrush x:Key="SurfaceAltBrush"        Color="#F9FAFB"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"       Color="#1F2937"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"     Color="#64748B"/>
    <SolidColorBrush x:Key="TextMutedBrush"         Color="#94A3B8"/>

    <!-- Borders / dividers -->
    <SolidColorBrush x:Key="BorderBrush"            Color="#E5E7EB"/>
    <SolidColorBrush x:Key="BorderSoftBrush"        Color="#F1F5F9"/>

    <!-- Brand accent (kept the same across themes so identity stays) -->
    <SolidColorBrush x:Key="AccentBrush"            Color="#00B894"/>
    <SolidColorBrush x:Key="AccentHoverBrush"       Color="#00967A"/>
    <SolidColorBrush x:Key="AccentMutedBrush"       Color="#E0F2F1"/>
    <SolidColorBrush x:Key="AccentMutedPressedBrush" Color="#B2DFDB"/>

    <!-- Status colors -->
    <SolidColorBrush x:Key="DangerBrush"            Color="#EF4444"/>
    <SolidColorBrush x:Key="SuccessBrush"           Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush"           Color="#F59E0B"/>
    <SolidColorBrush x:Key="InfoBrush"              Color="#3B82F6"/>

    <!-- Icon button foreground -->
    <SolidColorBrush x:Key="IconForegroundBrush"    Color="#64748B"/>

    <!-- Shadow alpha (used by drop shadow effects via opacity, not directly) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CardShadowOpacity">0.12</sys:Double>

</ResourceDictionary>
