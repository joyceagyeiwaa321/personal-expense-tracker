<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / page background -->
    <SolidColorBrush x:Key="BackgroundBrush"        Color="#0F172A"/>
    <!-- Top nav bar -->
    <SolidColorBrush x:Key="NavBarBrush"            Color="#1E293B"/>
    <!-- Cards / panels -->
    <SolidColorBrush x:Key="SurfaceBrush"           Color="#1E293B"/>
    <!-- Slightly elevated surfaces -->
    <SolidColorBrush x:Key="SurfaceAltBrush"        Color="#273449"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"       Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"     Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush"         Color="#64748B"/>

    <!-- Borders / dividers -->
    <SolidColorBrush x:Key="BorderBrush"            Color="#334155"/>
    <SolidColorBrush x:Key="BorderSoftBrush"        Color="#273449"/>

    <!-- Brand accent (same in both themes) -->
    <SolidColorBrush x:Key="AccentBrush"            Color="#00B894"/>
    <SolidColorBrush x:Key="AccentHoverBrush"       Color="#00D4A8"/>
    <SolidColorBrush x:Key="AccentMutedBrush"       Color="#134E48"/>
    <SolidColorBrush x:Key="AccentMutedPressedBrush" Color="#1A6B62"/>

    <!-- Status colors -->
    <SolidColorBrush x:Key="DangerBrush"            Color="#F87171"/>
    <SolidColorBrush x:Key="SuccessBrush"           Color="#34D399"/>
    <SolidColorBrush x:Key="WarningBrush"           Color="#FBBF24"/>
    <SolidColorBrush x:Key="InfoBrush"              Color="#60A5FA"/>

    <!-- Icon button foreground -->
    <SolidColorBrush x:Key="IconForegroundBrush"    Color="#CBD5E1"/>

    <!-- Shadow alpha -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CardShadowOpacity">0.4</sys:Double>

</ResourceDictionary>
