<Window x:Class="FinancyApplication.BudgetPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Budget Planner"
        Width="1180"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

	<Window.Resources>
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.12"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="NavButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Margin" Value="10,0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="IconButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="8,0"/>
		</Style>

		<Style x:Key="GreenButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="16,8"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00967A"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="EditButton" TargetType="Button">
			<Setter Property="Background" Value="#F59E0B"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="15">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#D97706"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DeleteButton" TargetType="Button">
			<Setter Property="Background" Value="#EF4444"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="15">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#DC2626"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<DockPanel>

		<!-- NAV BAR (identical structure to Dashboard) -->
		<Border x:Name="NavBar" DockPanel.Dock="Top" Height="72" Background="{DynamicResource NavBarBrush}">
			<Grid Margin="120,12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- LOGO -->
				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<Border Width="46" Height="46" CornerRadius="11" Background="#00B894" Margin="0,0,10,0">
						<Image Source="pack://application:,,,/Images/logo.png"
                               Width="36" Height="36" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<TextBlock x:Name="LogoText" Text="ExpenseTrack"
                               FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
				</StackPanel>

				<!-- NAV LINKS -->
				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
					<Button Content="Dashboard"  Style="{StaticResource NavButtonStyle}" Click="NavDashboard_Click"/>
					<Button Content="Transactions" Style="{StaticResource NavButtonStyle}" Click="NavTransactions_Click"/>
					<Button Content="Budget"
                            Style="{StaticResource NavButtonStyle}"
                            Foreground="#00B894"
                            FontWeight="Bold"
                            Click="NavBudget_Click"/>
					<Button Content="Goals"    Style="{StaticResource NavButtonStyle}" Click="NavGoals_Click"/>
					<Button Content="Reports"  Style="{StaticResource NavButtonStyle}" Click="NavReports_Click"/>
					<Button Content="Group"    Style="{StaticResource NavButtonStyle}" Click="NavGroups_Click"/>
				</StackPanel>

				<!-- RIGHT ICONS -->
				<StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
					<Button Style="{StaticResource IconButtonStyle}" Click="ThemeToggle_Click">
						<TextBlock x:Name="ThemeIcon" FontFamily="Segoe Fluent Icons"
                                   Text="&#xE706;" FontSize="23" Foreground="{DynamicResource TextSecondaryBrush}"/>
					</Button>
					<Button Style="{StaticResource IconButtonStyle}" Click="NavProfile_Click">
						<Border Width="38" Height="38" CornerRadius="19" Background="#00B894">
							<TextBlock x:Name="AvatarInitial" Text="U"
                                       Foreground="White" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- MAIN CONTENT -->
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Width="880" HorizontalAlignment="Center" Margin="0,40,0,30">

				<!-- PAGE HEADER -->
				<Grid Margin="0,0,0,6">
					<StackPanel>
						<TextBlock Text="Budget Planner"
                                   FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
						<TextBlock Text="Plan and monitor your monthly limits"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
					</StackPanel>
					<Button x:Name="AddBudgetButton"
                            Content="+ Add New Budget"
                            Style="{StaticResource GreenButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="AddBudget_Click"/>
				</Grid>

				<!-- FILTERS -->
				<StackPanel Orientation="Horizontal" Margin="0,18,0,22">
					<ComboBox x:Name="MonthComboBox"
                              Width="160" Height="32"
                              FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,12,0"
                              SelectionChanged="MonthComboBox_SelectionChanged"/>

					<ComboBox x:Name="CategoryFilterComboBox"
                              Width="160" Height="32"
                              FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                              SelectionChanged="CategoryFilter_SelectionChanged"/>
				</StackPanel>

				<!-- KPI CARDS -->
				<UniformGrid Columns="3" Margin="0,0,0,28">

					<Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
						<StackPanel>
							<TextBlock Text="Total Budget" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock x:Name="KpiTotalBudget"
                                       FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,10,0,0"/>
							<TextBlock x:Name="KpiTotalBudgetSub"
                                       FontSize="12" Foreground="#00B894" Margin="0,8,0,0"/>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource CardStyle}" Margin="7,0,7,0">
						<StackPanel>
							<TextBlock Text="Total Spent" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock x:Name="KpiTotalSpent"
                                       FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,10,0,0"/>
							<TextBlock x:Name="KpiTotalSpentSub"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource CardStyle}" Margin="14,0,0,0">
						<StackPanel>
							<TextBlock Text="Remaining" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock x:Name="KpiRemaining"
                                       FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,10,0,0"/>
							<!-- Progress bar -->
							<Grid Margin="0,10,0,0">
								<Border Background="#E5E7EB" CornerRadius="4" Height="8"/>
								<Border x:Name="OverallProgressBar"
                                        Background="#00B894" CornerRadius="4" Height="8"
                                        HorizontalAlignment="Left" Width="0"/>
								<TextBlock x:Name="OverallProgressLabel"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,-1,0,0"/>
							</Grid>
						</StackPanel>
					</Border>

				</UniformGrid>

				<!-- BUDGET TABLE -->
				<Border Style="{StaticResource CardStyle}" Margin="0,0,0,28">
					<StackPanel>

						<!-- Table Header -->
						<Grid Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*"/>
								<ColumnDefinition Width="1*"/>
								<ColumnDefinition Width="1*"/>
								<ColumnDefinition Width="1*"/>
								<ColumnDefinition Width="2*"/>
								<ColumnDefinition Width="80"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Category"   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Grid.Column="1" Text="Limit"      FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Grid.Column="2" Text="Spent"      FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Grid.Column="3" Text="Remaining"  FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Grid.Column="4" Text="Progress"   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Grid.Column="5" Text="Actions"    FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
						</Grid>

						<Separator Background="#E5E7EB" Margin="0,0,0,8"/>

						<!-- No budgets message -->
						<TextBlock x:Name="NoBudgetsPanel"
                                   Text="No budgets set for this period. Click '+ Add New Budget' to get started."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   Margin="0,8,0,8"
                                   Visibility="Collapsed"/>

						<!-- Budget rows injected here -->
						<StackPanel x:Name="BudgetRowsPanel"/>

					</StackPanel>
				</Border>

				<!-- BUDGET INSIGHTS -->
				<TextBlock Text="Budget Insights"
                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,16"/>

				<Grid Margin="0,0,0,30">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1.05*"/>
						<ColumnDefinition Width="1*"/>
					</Grid.ColumnDefinitions>

					<!-- Budget vs Spending line chart -->
					<Border Grid.Column="0" Style="{StaticResource CardStyle}" Height="280" Margin="0,0,20,0">
						<StackPanel>
							<Grid>
								<TextBlock Text="Budget vs Spending Over Time"
                                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
								<TextBlock Text="Monthly trend"
                                           HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
							</Grid>
							<Canvas x:Name="BudgetLineCanvas" Height="205" Margin="0,12,0,0"/>
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
								<TextBlock Text="━ Budget" Foreground="#3B82F6" FontSize="12" Margin="10,0"/>
								<TextBlock Text="━ Spent"  Foreground="#EF4444" FontSize="12" Margin="10,0"/>
							</StackPanel>
						</StackPanel>
					</Border>

					<!-- Category-wise pie chart -->
					<Border Grid.Column="1" Style="{StaticResource CardStyle}" Height="280">
						<Grid>
							<StackPanel>
								<TextBlock Text="Category-wise Budget Allocation"
                                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
								<Canvas x:Name="BudgetPieCanvas"
                                        Width="180" Height="180"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"/>
							</StackPanel>
							<StackPanel x:Name="PieLegendPanel"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,30,4,0"/>
						</Grid>
					</Border>
				</Grid>

				<!-- FOOTER -->
				<Grid Margin="0,4,0,0">
					<TextBlock Text="© 2026 ExpenseTrack. All rights reserved."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<Button Content="Privacy Policy" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Padding="0" Margin="0,0,25,0" Cursor="Hand" Click="FooterPrivacy_Click"/>
						<Button Content="Terms of Use" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Padding="0" Margin="0,0,25,0" Cursor="Hand" Click="FooterPrivacy_Click"/>
						<Button Content="Contact" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Padding="0" Cursor="Hand" Click="FooterPrivacy_Click"/>
					</StackPanel>
				</Grid>

			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</Window>
