<Window x:Class="FinancyApplication.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Profile - Financy"
        Width="900" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI Variable Display">

	<Window.Resources>
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="28"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TealButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="20,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00897B"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00695C"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GrayButton" TargetType="Button">
			<Setter Property="Background" Value="#F1F5F9"/>
			<Setter Property="Foreground" Value="#374151"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="20,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DangerButton" TargetType="Button">
			<Setter Property="Background" Value="#EF4444"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="20,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#DC2626"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="InputField" TargetType="TextBox">
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="#1F2937"/>
			<Setter Property="Background" Value="#F9FAFB"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
							<ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="#00B894"/>
								<Setter Property="Background" Value="White"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="PassField" TargetType="PasswordBox">
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="#1F2937"/>
			<Setter Property="Background" Value="#F9FAFB"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="PasswordBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
							<ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="#00B894"/>
								<Setter Property="Background" Value="White"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#6B7280"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- TOP BAR -->
		<Border Grid.Row="0" Background="White" Padding="40,18">
			<Border.Effect>
				<DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
			</Border.Effect>
			<Grid>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Border Width="38" Height="38" CornerRadius="9" Background="#00B894" Margin="0,0,10,0">
						<TextBlock Text="F" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<TextBlock Text="Financy" FontSize="16" FontWeight="Bold"
                               Foreground="#1F2937" VerticalAlignment="Center"/>
				</StackPanel>
				<Button Content="← Back to Dashboard" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#00B894" FontWeight="SemiBold" FontSize="13"
                        Cursor="Hand" Click="Back_Click"/>
			</Grid>
		</Border>

		<!-- MAIN CONTENT -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="40,30,40,10">
			<StackPanel>
				<TextBlock Text="My Profile" FontSize="22" FontWeight="Bold"
                           Foreground="#1F2937" Margin="0,0,0,24"/>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="320"/>
						<ColumnDefinition Width="20"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- LEFT: AVATAR + NAME CARD -->
					<Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
						<StackPanel>
							<!-- Avatar circle with initial -->
							<Border Width="80" Height="80" CornerRadius="40"
                                    Background="#00B894" HorizontalAlignment="Center" Margin="0,0,0,16">
								<TextBlock x:Name="AvatarInitialText" Text="U"
                                           FontSize="32" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>

							<TextBlock x:Name="DisplayName" Text="Your Name"
                                       FontSize="17" FontWeight="Bold" Foreground="#1F2937"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
							<TextBlock x:Name="DisplayEmail" Text="email@example.com"
                                       FontSize="13" Foreground="#6B7280"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
							<Border Background="#E0F2F1" CornerRadius="10" Padding="10,4"
                                    HorizontalAlignment="Center" Margin="0,0,0,20">
								<TextBlock x:Name="DisplayRole" Text="User"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#00695C"/>
							</Border>

							<!-- Member since -->
							<Border Background="#F9FAFB" CornerRadius="8" Padding="12,10" Margin="0,0,0,20">
								<StackPanel>
									<TextBlock Text="MEMBER SINCE" FontSize="10" FontWeight="Bold"
                                               Foreground="#9CA3AF"/>
									<TextBlock x:Name="DisplayMemberSince" Text="—"
                                               FontSize="13" Foreground="#374151" Margin="0,3,0,0"/>
								</StackPanel>
							</Border>

							<Button Content="Edit Profile" Style="{StaticResource TealButton}"
                                    Width="220" Click="EditProfile_Click" Margin="0,0,0,10"/>
							<Button Content="Change Password" Style="{StaticResource GrayButton}"
                                    Width="220" Click="ShowChangePassword_Click"/>
						</StackPanel>
					</Border>

					<!-- RIGHT PANEL: tabs between Edit / Settings / Password -->
					<Grid Grid.Column="2">

						<!-- PROFILE INFO VIEW (read mode) -->
						<Border x:Name="InfoView" Style="{StaticResource CardStyle}" Visibility="Visible">
							<StackPanel>
								<TextBlock Text="Profile Information" FontSize="15" FontWeight="Bold"
                                           Foreground="#1F2937" Margin="0,0,0,20"/>

								<Grid Margin="0,0,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="16"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="FIRST NAME" Style="{StaticResource FieldLabel}"/>
										<TextBlock x:Name="InfoFirstName" Text="—"
                                                   FontSize="14" Foreground="#1F2937"/>
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Text="LAST NAME" Style="{StaticResource FieldLabel}"/>
										<TextBlock x:Name="InfoLastName" Text="—"
                                                   FontSize="14" Foreground="#1F2937"/>
									</StackPanel>
								</Grid>

								<Grid Margin="0,0,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="16"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
										<TextBlock x:Name="InfoUsername" Text="—"
                                                   FontSize="14" Foreground="#1F2937"/>
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Text="PHONE NUMBER" Style="{StaticResource FieldLabel}"/>
										<TextBlock x:Name="InfoPhone" Text="—"
                                                   FontSize="14" Foreground="#1F2937"/>
									</StackPanel>
								</Grid>

								<StackPanel Margin="0,0,0,16">
									<TextBlock Text="EMAIL ADDRESS" Style="{StaticResource FieldLabel}"/>
									<TextBlock x:Name="InfoEmail" Text="—"
                                               FontSize="14" Foreground="#1F2937"/>
								</StackPanel>

								<StackPanel Margin="0,0,0,24">
									<TextBlock Text="PREFERRED CURRENCY" Style="{StaticResource FieldLabel}"/>
									<TextBlock x:Name="InfoCurrency" Text="—"
                                               FontSize="14" Foreground="#1F2937"/>
								</StackPanel>

								<!-- Notification Preferences (display) -->
								<TextBlock Text="Notification Preferences" FontSize="15" FontWeight="Bold"
                                           Foreground="#1F2937" Margin="0,0,0,14"/>

								<StackPanel Margin="0,0,0,24">
									<CheckBox x:Name="ChkBudgetAlerts" Content="Budget Limit Alerts"
                                              IsEnabled="False" Foreground="#374151" Margin="0,0,0,8">
										<CheckBox.Style>
											<Style TargetType="CheckBox">
												<Setter Property="Template">
													<Setter.Value>
														<ControlTemplate TargetType="CheckBox">
															<StackPanel Orientation="Horizontal">
																<Border Width="18" Height="18" CornerRadius="4"
                                                                        Background="#00B894" Margin="0,0,8,0">
																	<TextBlock Text="✓" FontSize="11" FontWeight="Bold"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
																</Border>
																<ContentPresenter VerticalAlignment="Center"/>
															</StackPanel>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</CheckBox.Style>
									</CheckBox>
									<CheckBox x:Name="ChkGoalReminders" Content="Goal Reminders"
                                              IsEnabled="False" Foreground="#374151" Margin="0,0,0,8">
										<CheckBox.Style>
											<Style TargetType="CheckBox">
												<Setter Property="Template">
													<Setter.Value>
														<ControlTemplate TargetType="CheckBox">
															<StackPanel Orientation="Horizontal">
																<Border Width="18" Height="18" CornerRadius="4"
                                                                        Background="#00B894" Margin="0,0,8,0">
																	<TextBlock Text="✓" FontSize="11" FontWeight="Bold"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
																</Border>
																<ContentPresenter VerticalAlignment="Center"/>
															</StackPanel>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</CheckBox.Style>
									</CheckBox>
									<CheckBox x:Name="ChkWeeklySummary" Content="Weekly Summary Emails"
                                              IsEnabled="False" Foreground="#374151">
										<CheckBox.Style>
											<Style TargetType="CheckBox">
												<Setter Property="Template">
													<Setter.Value>
														<ControlTemplate TargetType="CheckBox">
															<StackPanel Orientation="Horizontal">
																<Border Width="18" Height="18" CornerRadius="4"
                                                                        Background="#00B894" Margin="0,0,8,0">
																	<TextBlock Text="✓" FontSize="11" FontWeight="Bold"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
																</Border>
																<ContentPresenter VerticalAlignment="Center"/>
															</StackPanel>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</CheckBox.Style>
									</CheckBox>
								</StackPanel>

								<!-- Export / Danger -->
								<StackPanel Orientation="Horizontal">
									<Button Content="Export Data" Style="{StaticResource TealButton}"
                                            Margin="0,0,12,0" Click="ExportData_Click"/>
									<Button Content="Clear All Data" Style="{StaticResource DangerButton}"
                                            Click="ClearAllData_Click"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- EDIT PROFILE VIEW -->
						<Border x:Name="EditView" Style="{StaticResource CardStyle}" Visibility="Collapsed">
							<StackPanel>
								<TextBlock Text="Edit Profile" FontSize="15" FontWeight="Bold"
                                           Foreground="#1F2937" Margin="0,0,0,20"/>

								<Grid Margin="0,0,0,14">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="14"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="First Name" Style="{StaticResource FieldLabel}"/>
										<TextBox x:Name="EditFirstName" Style="{StaticResource InputField}"/>
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Text="Last Name" Style="{StaticResource FieldLabel}"/>
										<TextBox x:Name="EditLastName" Style="{StaticResource InputField}"/>
									</StackPanel>
								</Grid>

								<StackPanel Margin="0,0,0,14">
									<TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
									<TextBox x:Name="EditUsername" Style="{StaticResource InputField}"/>
								</StackPanel>

								<StackPanel Margin="0,0,0,14">
									<TextBlock Text="Phone Number" Style="{StaticResource FieldLabel}"/>
									<TextBox x:Name="EditPhone" Style="{StaticResource InputField}"/>
								</StackPanel>

								<StackPanel Margin="0,0,0,20">
									<TextBlock Text="Preferred Currency" Style="{StaticResource FieldLabel}"/>
									<ComboBox x:Name="EditCurrency" Height="40" FontSize="13"
                                              Background="#F9FAFB" BorderBrush="#E5E7EB"/>
								</StackPanel>

								<TextBlock x:Name="EditFeedback" FontSize="12" Margin="0,0,0,12"
                                           Visibility="Collapsed"/>

								<StackPanel Orientation="Horizontal">
									<Button Content="Save Changes" Style="{StaticResource TealButton}"
                                            Margin="0,0,12,0" Click="SaveProfile_Click"/>
									<Button Content="Cancel" Style="{StaticResource GrayButton}"
                                            Click="CancelEdit_Click"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- CHANGE PASSWORD VIEW -->
						<Border x:Name="PasswordView" Style="{StaticResource CardStyle}" Visibility="Collapsed">
							<StackPanel>
								<TextBlock Text="Change Password" FontSize="15" FontWeight="Bold"
                                           Foreground="#1F2937" Margin="0,0,0,20"/>

								<StackPanel Margin="0,0,0,14">
									<TextBlock Text="Current Password" Style="{StaticResource FieldLabel}"/>
									<PasswordBox x:Name="CurrentPass" Style="{StaticResource PassField}"/>
								</StackPanel>

								<StackPanel Margin="0,0,0,6">
									<TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
									<PasswordBox x:Name="NewPass" Style="{StaticResource PassField}"
                                                 PasswordChanged="NewPass_PasswordChanged"/>
								</StackPanel>

								<!-- Strength bar -->
								<ProgressBar x:Name="PassStrengthBar" Height="4" Minimum="0" Maximum="4"
                                             Value="0" Background="#E5E7EB" Margin="0,0,0,4">
									<ProgressBar.Template>
										<ControlTemplate TargetType="ProgressBar">
											<Border CornerRadius="2" Background="{TemplateBinding Background}">
												<Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                        CornerRadius="2" Background="#00B894"/>
											</Border>
										</ControlTemplate>
									</ProgressBar.Template>
								</ProgressBar>
								<TextBlock x:Name="PassStrengthLabel" FontSize="11"
                                           Foreground="#6B7280" Margin="0,0,0,14"/>

								<StackPanel Margin="0,0,0,20">
									<TextBlock Text="Confirm New Password" Style="{StaticResource FieldLabel}"/>
									<PasswordBox x:Name="ConfirmNewPass" Style="{StaticResource PassField}"/>
								</StackPanel>

								<TextBlock x:Name="PassFeedback" FontSize="12" Margin="0,0,0,12"
                                           Visibility="Collapsed"/>

								<StackPanel Orientation="Horizontal">
									<Button Content="Update Password" Style="{StaticResource TealButton}"
                                            Margin="0,0,12,0" Click="SavePassword_Click"/>
									<Button Content="Cancel" Style="{StaticResource GrayButton}"
                                            Click="CancelEdit_Click"/>
								</StackPanel>
							</StackPanel>
						</Border>

					</Grid>
				</Grid>
			</StackPanel>
		</ScrollViewer>

		<!-- FOOTER -->
		<Border Grid.Row="2" Background="White" Padding="40,14">
			<Grid>
				<TextBlock Text="© 2026 ExpenseTrack. All rights reserved."
                           Foreground="#64748B" FontSize="12"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<TextBlock Text="Privacy Policy" Foreground="#64748B" FontSize="12" Margin="0,0,25,0"/>
					<TextBlock Text="Terms of Use" Foreground="#64748B" FontSize="12" Margin="0,0,25,0"/>
					<TextBlock Text="Contact" Foreground="#64748B" FontSize="12"/>
				</StackPanel>
			</Grid>
		</Border>

	</Grid>
</Window>
