<UserControl x:Class="FinancyApplication.ProfileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Display">

	<UserControl.Resources>
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="28"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TealButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="20,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00897B"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00695C"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GrayButton" TargetType="Button">
			<Setter Property="Background" Value="#F1F5F9"/>
			<Setter Property="Foreground" Value="#374151"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="20,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DangerButton" TargetType="Button">
			<Setter Property="Background" Value="#EF4444"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="20,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#DC2626"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="InputField" TargetType="TextBox">
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
							<ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="#00B894"/>
								<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="PassField" TargetType="PasswordBox">
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="PasswordBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
							<ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="#00B894"/>
								<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#6B7280"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
		</Style>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- MAIN CONTENT -->
		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="40,30,40,10">
			<StackPanel>
				<TextBlock Text="My Profile" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="320"/>
						<ColumnDefinition Width="20"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- LEFT: AVATAR + NAME CARD -->
					<Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
						<StackPanel>
							<!-- Avatar circle with initial -->
							<Button x:Name="AvatarButton" Width="80" Height="80"
                                    HorizontalAlignment="Center" Margin="0,0,0,16"
                                    Cursor="Hand" Click="AvatarButton_Click"
                                    Background="Transparent" BorderThickness="0" Padding="0">
								<Button.Template>
									<ControlTemplate TargetType="Button">
										<Grid>
											<!-- Teal initial circle (shown when no photo) -->
											<Border x:Name="AvatarCircle" Width="80" Height="80" CornerRadius="40"
                                                    Background="#00B894">
												<TextBlock x:Name="AvatarInitialText" Text="U"
                                                           FontSize="32" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
											</Border>

											<!-- Photo (shown when uploaded) -->
											<Border Width="80" Height="80" CornerRadius="40" ClipToBounds="True">
												<Image x:Name="AvatarImage" Stretch="UniformToFill"
                                                       Visibility="Collapsed"/>
											</Border>

											<!-- Hover overlay -->
											<Border x:Name="AvatarOverlay" Width="80" Height="80" CornerRadius="40"
                                                    Background="#80000000" Visibility="Collapsed">
												<TextBlock Text="📷" FontSize="22"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
											</Border>
										</Grid>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter TargetName="AvatarOverlay" Property="Visibility" Value="Visible"/>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Button.Template>
							</Button>

							<TextBlock x:Name="DisplayName" Text="Your Name"
                                       FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
							<TextBlock x:Name="DisplayEmail" Text="email@example.com"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
							<Border x:Name="RoleBadge" Background="#E0F2F1" CornerRadius="10" Padding="10,4"
                                    HorizontalAlignment="Center" Margin="0,0,0,20">
								<TextBlock x:Name="DisplayRole" Text="User"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#00695C"/>
							</Border>
							<Border Background="#F9FAFB" CornerRadius="8" Padding="12,10" Margin="0,0,0,20">
								<StackPanel>
									<TextBlock Text="MEMBER SINCE" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
									<TextBlock x:Name="DisplayMemberSince" Text="—"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
								</StackPanel>
							</Border>

							<Button Content="Edit Profile" Style="{StaticResource TealButton}"
                                    Width="220" Click="EditProfile_Click" Margin="0,0,0,10"/>
							<Button Content="Change Password" Style="{StaticResource GrayButton}"
                                    Width="220" Click="ShowChangePassword_Click" Margin="0,0,0,10"/>
							<Button Width="220" Height="38" Cursor="Hand"
									Background="#EF4444" Foreground="White"
									BorderThickness="0" Click="SignOut_Click">
								<Button.Template>
									<ControlTemplate TargetType="Button">
										<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8">
											<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
												<TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
														   Foreground="White" Margin="0,0,7,0" VerticalAlignment="Center"/>
												<TextBlock Text="Sign Out" FontFamily="Segoe UI" FontSize="13"
														   FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
											</StackPanel>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter TargetName="bg" Property="Background" Value="#DC2626"/>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Button.Template>
							</Button>
						</StackPanel>
					</Border>

					<!-- RIGHT PANEL: tabs between Edit / Settings / Password -->
					<Grid Grid.Column="2">

						<!-- PROFILE INFO VIEW (read mode) -->
						<Border x:Name="InfoView" Style="{StaticResource CardStyle}" Visibility="Visible">
							<StackPanel>
								<TextBlock Text="Profile Information" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

								<Grid Margin="0,0,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="16"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="FIRST NAME" Style="{StaticResource FieldLabel}"/>
										<TextBlock x:Name="InfoFirstName" Text="—"
                                                   FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Text="LAST NAME" Style="{StaticResource FieldLabel}"/>
										<TextBlock x:Name="InfoLastName" Text="—"
                                                   FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
									</StackPanel>
								</Grid>

								<Grid Margin="0,0,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="16"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
										<TextBlock x:Name="InfoUsername" Text="—"
                                                   FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Text="PHONE NUMBER" Style="{StaticResource FieldLabel}"/>
										<TextBlock x:Name="InfoPhone" Text="—"
                                                   FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
									</StackPanel>
								</Grid>

								<StackPanel Margin="0,0,0,16">
									<TextBlock Text="EMAIL ADDRESS" Style="{StaticResource FieldLabel}"/>
									<TextBlock x:Name="InfoEmail" Text="—"
                                               FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
								</StackPanel>

								<StackPanel Margin="0,0,0,24">
									<TextBlock Text="PREFERRED CURRENCY" Style="{StaticResource FieldLabel}"/>
									<TextBlock x:Name="InfoCurrency" Text="—"
                                               FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
								</StackPanel>

								<!-- Notification Preferences -->
								<TextBlock Text="Notification Preferences" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

								<StackPanel Margin="0,0,0,24">
									<CheckBox x:Name="ChkGoalReminders"
											  Content="Goal Reminders"
											  FontSize="13"
											  Foreground="{DynamicResource TextPrimaryBrush}"
											  Checked="NotifCheckbox_Changed"
											  Unchecked="NotifCheckbox_Changed"/>
								</StackPanel>

								<!-- Export / Danger -->
								<StackPanel Orientation="Horizontal">
									<Button Content="Clear All Data" Style="{StaticResource DangerButton}"
                                            Click="ClearAllData_Click"/>

								</StackPanel>

								<!-- AI SETTINGS -->
								<TextBlock Text="AI Settings" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,24,0,8"/>
								<TextBlock Text="Your OpenAI API key is used for smart CSV column mapping and auto-categorization when importing bank exports."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
								<StackPanel Margin="0,0,0,6">
									<TextBlock Text="OPENAI API KEY" Style="{StaticResource FieldLabel}"/>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="8"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<TextBox x:Name="ApiKeyInput" Grid.Column="0"
                                                 Style="{StaticResource InputField}"
                                                 ToolTip="Paste your sk-... key here"/>
										<Button Grid.Column="2" Content="Save Key"
                                                Style="{StaticResource TealButton}"
                                                Click="SaveApiKey_Click"/>
									</Grid>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- EDIT PROFILE VIEW -->
						<Border x:Name="EditView" Style="{StaticResource CardStyle}" Visibility="Collapsed">
							<StackPanel>
								<TextBlock Text="Edit Profile" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

								<Grid Margin="0,0,0,14">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="14"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="First Name" Style="{StaticResource FieldLabel}"/>
										<TextBox x:Name="EditFirstName" Style="{StaticResource InputField}"/>
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Text="Last Name" Style="{StaticResource FieldLabel}"/>
										<TextBox x:Name="EditLastName" Style="{StaticResource InputField}"/>
									</StackPanel>
								</Grid>

								<StackPanel Margin="0,0,0,14">
									<TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
									<TextBox x:Name="EditUsername" Style="{StaticResource InputField}"/>
								</StackPanel>

								<StackPanel Margin="0,0,0,14">
									<TextBlock Text="Phone Number" Style="{StaticResource FieldLabel}"/>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
										</Grid.ColumnDefinitions>

										<!-- Country code picker -->
										<ComboBox x:Name="PhoneCountryPicker"
                                                  Grid.Column="0"
                                                  Height="40" Width="110"
                                                  FontSize="13"
                                                  Background="#F9FAFB"
                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                  Margin="0,0,6,0"
                                                  SelectionChanged="PhoneCountryPicker_SelectionChanged"
                                                  Cursor="Hand">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<StackPanel Orientation="Horizontal">
														<TextBlock Text="{Binding Flag}" FontSize="15" Margin="0,0,5,0"
                                                                   VerticalAlignment="Center"/>
														<TextBlock Text="{Binding Dial}" FontSize="13"
                                                                   VerticalAlignment="Center"/>
													</StackPanel>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>

										<!-- Number field -->
										<TextBox x:Name="EditPhone" Grid.Column="1"
                                                 Style="{StaticResource InputField}"/>
									</Grid>
								</StackPanel>

								<StackPanel Margin="0,0,0,20">
									<TextBlock Text="Preferred Currency" Style="{StaticResource FieldLabel}"/>
									<ComboBox x:Name="EditCurrency" Height="40" FontSize="13"
                                              Background="#F9FAFB" BorderBrush="{DynamicResource BorderBrush}"/>
								</StackPanel>

								<TextBlock x:Name="EditFeedback" FontSize="12" Margin="0,0,0,12"
                                           Visibility="Collapsed"/>

								<StackPanel Orientation="Horizontal">
									<Button Content="Save Changes" Style="{StaticResource TealButton}"
                                            Margin="0,0,12,0" Click="SaveProfile_Click"/>
									<Button Content="Cancel" Style="{StaticResource GrayButton}"
                                            Click="CancelEdit_Click"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- CHANGE PASSWORD VIEW -->
						<Border x:Name="PasswordView" Style="{StaticResource CardStyle}" Visibility="Collapsed">
							<StackPanel>
								<TextBlock Text="Change Password" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

								<StackPanel Margin="0,0,0,14">
									<TextBlock Text="Current Password" Style="{StaticResource FieldLabel}"/>
									<PasswordBox x:Name="CurrentPass" Style="{StaticResource PassField}"/>
								</StackPanel>

								<StackPanel Margin="0,0,0,6">
									<TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
									<PasswordBox x:Name="NewPass" Style="{StaticResource PassField}"
                                                 PasswordChanged="NewPass_PasswordChanged"/>
								</StackPanel>

								<!-- Strength bar -->
								<ProgressBar x:Name="PassStrengthBar" Height="4" Minimum="0" Maximum="4"
                                             Value="0" Background="#E5E7EB" Margin="0,0,0,4">
									<ProgressBar.Template>
										<ControlTemplate TargetType="ProgressBar">
											<Border CornerRadius="2" Background="{TemplateBinding Background}">
												<Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                        CornerRadius="2" Background="#00B894"/>
											</Border>
										</ControlTemplate>
									</ProgressBar.Template>
								</ProgressBar>
								<TextBlock x:Name="PassStrengthLabel" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

								<StackPanel Margin="0,0,0,20">
									<TextBlock Text="Confirm New Password" Style="{StaticResource FieldLabel}"/>
									<PasswordBox x:Name="ConfirmNewPass" Style="{StaticResource PassField}"/>
								</StackPanel>

								<TextBlock x:Name="PassFeedback" FontSize="12" Margin="0,0,0,12"
                                           Visibility="Collapsed"/>

								<StackPanel Orientation="Horizontal">
									<Button Content="Update Password" Style="{StaticResource TealButton}"
                                            Margin="0,0,12,0" Click="SavePassword_Click"/>
									<Button Content="Cancel" Style="{StaticResource GrayButton}"
                                            Click="CancelEdit_Click"/>
								</StackPanel>
							</StackPanel>
						</Border>

					</Grid>
				</Grid>
			</StackPanel>
		</ScrollViewer>

		<!-- FOOTER -->
		<Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="40,14">
			<Grid>
				<TextBlock Text="© 2026 ExpenseTrack. All rights reserved."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<TextBlock Text="Privacy Policy" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,25,0"/>
					<TextBlock Text="Terms of Use" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,25,0"/>
					<TextBlock Text="Contact" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
				</StackPanel>
			</Grid>
		</Border>


		<!-- CLEAR ALL — Step 1 -->
		<Grid x:Name="ClearConfirmOverlay1" Visibility="Collapsed"
			  Grid.RowSpan="2" Background="#88000000">
			<Border MaxWidth="420" Background="White" CornerRadius="14" Padding="28"
					HorizontalAlignment="Center" VerticalAlignment="Center">
				<StackPanel>
					<TextBlock Text="Clear All Data?" FontSize="17" FontWeight="Bold"
							   Foreground="#1A2E22" Margin="0,0,0,10"/>
					<TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#4A6558" Margin="0,0,0,24"
							   Text="This will permanently delete all your transactions and cannot be undone."/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<Button Content="Cancel" Style="{StaticResource GrayButton}"
								Width="100" Margin="0,0,10,0" Click="ClearConfirm1_No"/>
						<Button Content="Yes, continue" Style="{StaticResource DangerButton}"
								Width="140" Click="ClearConfirm1_Yes"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>

		<!-- CLEAR ALL — Step 2 (final warning) -->
		<Grid x:Name="ClearConfirmOverlay2" Visibility="Collapsed"
			  Grid.RowSpan="2" Background="#AA000000">
			<Border MaxWidth="420" Background="White" CornerRadius="14" Padding="28"
					HorizontalAlignment="Center" VerticalAlignment="Center">
				<StackPanel>
					<TextBlock Text="⚠️ Final Warning" FontSize="17" FontWeight="Bold"
							   Foreground="#DC2626" Margin="0,0,0,10"/>
					<TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#4A6558" Margin="0,0,0,24"
							   Text="You are about to permanently delete ALL your transactions. This action is irreversible. Are you absolutely sure?"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<Button Content="Cancel" Style="{StaticResource GrayButton}"
								Width="100" Margin="0,0,10,0" Click="ClearConfirm2_No"/>
						<Button Content="Delete everything" Style="{StaticResource DangerButton}"
								Width="160" Click="ClearConfirm2_Yes"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>

	</Grid>
</UserControl>