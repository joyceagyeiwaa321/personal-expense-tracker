<UserControl x:Class="FinancyApplication.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F8F5">

	<UserControl.Resources>
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#1A5C38" Opacity="0.05" Direction="270"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GreenBtn" TargetType="Button">
			<Setter Property="Background" Value="#2ECC71"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Height" Value="38"/>
			<Setter Property="Padding" Value="16,0"/>
			<Setter Property="FontFamily" Value="Segoe UI Semibold"/>
			<Setter Property="FontSize" Value="12.5"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="b" Property="Background" Value="#27AE60"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="OutlineBtn" TargetType="Button">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#1A5C38"/>
			<Setter Property="BorderBrush" Value="#2ECC71"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Height" Value="38"/>
			<Setter Property="Padding" Value="16,0"/>
			<Setter Property="FontFamily" Value="Segoe UI Semibold"/>
			<Setter Property="FontSize" Value="12.5"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="b" Property="Background" Value="#E8F5EE"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource OutlineBtn}">
			<Setter Property="Foreground" Value="#E74C3C"/>
			<Setter Property="BorderBrush" Value="#E74C3C"/>
		</Style>

		<Style x:Key="Input" TargetType="TextBox">
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="BorderBrush" Value="#E0EDE6"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Background" Value="#FAFAFA"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
							<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="#2ECC71"/>
								<Setter Property="Background" Value="White"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="FilterCombo" TargetType="ComboBox">
			<Setter Property="Height" Value="36"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#E0EDE6"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
	</UserControl.Resources>

	<Grid>
		<!-- LANDING VIEW -->
		<ScrollViewer x:Name="LandingView" VerticalScrollBarVisibility="Auto" Padding="24,18,24,24">
			<StackPanel MaxWidth="600" HorizontalAlignment="Center">

				<Grid Margin="0,0,0,6">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="Groups" FontFamily="Segoe UI Black" FontSize="26"
							   Foreground="#1A2E22" VerticalAlignment="Center"/>
					<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
						<Button Style="{StaticResource GreenBtn}" Margin="0,0,8,0"
								Click="CreateGroup_Click">+ Create Group</Button>
						<Button Style="{StaticResource OutlineBtn}"
								Click="JoinGroup_Click">👥 Join Group</Button>
					</StackPanel>
				</Grid>
				<TextBlock Text="Collaborate on shared expenses with friends and family."
						   FontFamily="Segoe UI" FontSize="13" Foreground="#8FAF9F" Margin="0,0,0,24"/>

				<TextBlock Text="Groups You Created" FontFamily="Segoe UI Semibold"
						   FontSize="15" Foreground="#1A2E22" Margin="0,0,0,12"/>
				<ItemsControl x:Name="CreatedGroupsList">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="White" CornerRadius="12" Padding="16,14"
									Margin="0,0,0,10" Cursor="Hand">
								<Border.Effect>
									<DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06"/>
								</Border.Effect>
								<Border.InputBindings>
									<MouseBinding MouseAction="LeftClick"
												  Command="{Binding DataContext.OpenGroupCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
												  CommandParameter="{Binding}"/>
								</Border.InputBindings>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold"
												   FontSize="14" Foreground="#1A2E22"/>
										<TextBlock Text="{Binding Description}" FontFamily="Segoe UI"
												   FontSize="11.5" Foreground="#8FAF9F" Margin="0,3,0,0"/>
										<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
											<TextBlock Text="Members: " FontFamily="Segoe UI"
													   FontSize="11.5" Foreground="#8FAF9F"/>
											<TextBlock Text="{Binding MemberCount}" FontFamily="Segoe UI Semibold"
													   FontSize="11.5" Foreground="#4A6558"/>
										</StackPanel>
									</StackPanel>
									<Button Grid.Column="1" VerticalAlignment="Top"
											Background="Transparent" BorderThickness="0"
											Cursor="Hand" ToolTip="Copy invite code"
											Tag="{Binding InviteCode}"
											Click="CopyInviteCode_Click">
										<TextBlock Text="📋" FontSize="18"/>
									</Button>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<StackPanel x:Name="NoCreatedGroupsPanel" Visibility="Collapsed"
							HorizontalAlignment="Center" Margin="0,4,0,16">
					<TextBlock Text="You haven't created any groups yet."
							   FontFamily="Segoe UI" FontSize="12" Foreground="#8FAF9F"/>
				</StackPanel>

				<TextBlock Text="Groups You're a Member Of" FontFamily="Segoe UI Semibold"
						   FontSize="15" Foreground="#1A2E22" Margin="0,16,0,12"/>
				<ItemsControl x:Name="GroupsList">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="White" CornerRadius="12" Padding="16,14"
									Margin="0,0,0,10" Cursor="Hand">
								<Border.Effect>
									<DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06"/>
								</Border.Effect>
								<Border.InputBindings>
									<MouseBinding MouseAction="LeftClick"
												  Command="{Binding DataContext.OpenGroupCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
												  CommandParameter="{Binding}"/>
								</Border.InputBindings>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<Border Width="44" Height="44" CornerRadius="12"
											Background="#2ECC71" Margin="0,0,14,0">
										<TextBlock Text="👥" FontSize="20"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</Border>
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold"
												   FontSize="13.5" Foreground="#1A2E22"/>
										<TextBlock Text="{Binding Description}" FontFamily="Segoe UI"
												   FontSize="11.5" Foreground="#8FAF9F"/>
									</StackPanel>
									<StackPanel Grid.Column="2" VerticalAlignment="Center"
												HorizontalAlignment="Right">
										<TextBlock Text="{Binding MemberCount}" FontFamily="Segoe UI Semibold"
												   FontSize="12" Foreground="#2ECC71" HorizontalAlignment="Right"/>
										<TextBlock Text="members" FontFamily="Segoe UI" FontSize="10"
												   Foreground="#8FAF9F" HorizontalAlignment="Right"/>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<StackPanel x:Name="NoGroupsPanel" Visibility="Collapsed"
							HorizontalAlignment="Center" Margin="0,16">
					<TextBlock Text="👥" FontSize="36" HorizontalAlignment="Center"/>
					<TextBlock Text="You're not in any groups yet"
							   FontFamily="Segoe UI" FontSize="13" Foreground="#8FAF9F"
							   HorizontalAlignment="Center" Margin="0,8,0,0"/>
				</StackPanel>

			</StackPanel>
		</ScrollViewer>

		<!-- CREATE GROUP MODAL -->
		<Grid x:Name="CreateGroupModal" Visibility="Collapsed" Background="#88000000">
			<Border MaxWidth="460" Background="White" CornerRadius="16" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
				<StackPanel>
					<TextBlock Text="Create New Group" FontFamily="Segoe UI Black"
                               FontSize="18" Foreground="#1A2E22" Margin="0,0,0,20"/>
					<TextBlock Text="Group Name" FontFamily="Segoe UI Semibold"
                               FontSize="12" Foreground="#4A6558" Margin="0,0,0,6"/>
					<TextBox x:Name="NewGroupName" Style="{StaticResource Input}" Margin="0,0,0,16"/>
					<TextBlock Text="Description (optional)" FontFamily="Segoe UI Semibold"
                               FontSize="12" Foreground="#4A6558" Margin="0,0,0,6"/>
					<TextBox x:Name="NewGroupDesc" Style="{StaticResource Input}" Margin="0,0,0,24"/>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="10"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Button Grid.Column="0" Style="{StaticResource OutlineBtn}"
                                Click="CancelCreate_Click">Cancel</Button>
						<Button Grid.Column="2" Style="{StaticResource GreenBtn}"
                                Click="ConfirmCreate_Click">Create Group</Button>
					</Grid>
				</StackPanel>
			</Border>
		</Grid>

		<!-- GROUP CODE MODAL -->
		<Grid x:Name="GroupCodeModal" Visibility="Collapsed" Background="#88000000">
			<Border MaxWidth="460" Background="White" CornerRadius="16" Padding="28"
					HorizontalAlignment="Center" VerticalAlignment="Center">
				<StackPanel>
					<TextBlock Text="Create a new group" FontFamily="Segoe UI Black"
							   FontSize="18" Foreground="#1A2E22" Margin="0,0,0,12"/>
					<TextBlock Text="Your group has been created successfully!&#x0a;Share this code with others to join:"
							   FontFamily="Segoe UI" FontSize="13" Foreground="#4A6558"
							   TextWrapping="Wrap" Margin="0,0,0,16"/>
					<Border BorderBrush="#E0EDE6" BorderThickness="1.5" CornerRadius="8"
							Background="#FAFAFA" Padding="14,12" Margin="0,0,0,20">
						<Grid>
							<TextBlock x:Name="GroupCodeText" FontFamily="Segoe UI Semibold"
									   FontSize="18" Foreground="#1A2E22" VerticalAlignment="Center"/>
							<Button HorizontalAlignment="Right" Background="Transparent"
									BorderThickness="0" Cursor="Hand" ToolTip="Copy code"
									Click="CopyGroupCode_Click">
								<TextBlock Text="📋" FontSize="20"/>
							</Button>
						</Grid>
					</Border>
					<Button Style="{StaticResource GreenBtn}" HorizontalAlignment="Stretch"
							Click="CloseGroupCode_Click">Close</Button>
				</StackPanel>
			</Border>
		</Grid>

		<!-- JOIN GROUP MODAL -->
		<Grid x:Name="JoinGroupModal" Visibility="Collapsed" Background="#88000000">
			<Border MaxWidth="460" Background="White" CornerRadius="16" Padding="28"
					HorizontalAlignment="Center" VerticalAlignment="Center">
				<StackPanel>
					<TextBlock Text="Join a Group" FontFamily="Segoe UI Black"
							   FontSize="18" Foreground="#1A2E22" Margin="0,0,0,8"/>
					<TextBlock Text="Enter the invite code shared with you."
							   FontFamily="Segoe UI" FontSize="12" Foreground="#8FAF9F"
							   Margin="0,0,0,20"/>
					<TextBlock Text="Invite Code" FontFamily="Segoe UI Semibold"
							   FontSize="12" Foreground="#4A6558" Margin="0,0,0,6"/>
					<TextBox x:Name="JoinCodeInput" Style="{StaticResource Input}" Margin="0,0,0,24"/>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="10"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Button Grid.Column="0" Style="{StaticResource OutlineBtn}"
								Click="CancelJoin_Click">Cancel</Button>
						<Button Grid.Column="2" Style="{StaticResource GreenBtn}"
								Click="ConfirmJoin_Click">Join Group</Button>
					</Grid>
				</StackPanel>
			</Border>
		</Grid>

		<!-- GROUP EXPENSES VIEW -->
		<Grid x:Name="GroupExpensesView" Visibility="Collapsed">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="260"/>
			</Grid.ColumnDefinitions>

			<!-- Left: Expenses -->
			<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24,18,8,24">
				<StackPanel>

					<Grid Margin="0,0,0,16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<StackPanel Orientation="Horizontal">
								<Button Background="Transparent" BorderThickness="0"
                                        Foreground="#2ECC71" FontSize="13" Cursor="Hand"
                                        Click="BackToGroups_Click" Margin="0,0,8,0">← Back</Button>
								<TextBlock x:Name="GroupNameTitle" Text="Group Expenses"
                                           FontFamily="Segoe UI Black" FontSize="22"
                                           Foreground="#1A2E22" VerticalAlignment="Center"/>
							</StackPanel>
							<TextBlock x:Name="GroupMembersLabel" Text=""
										FontFamily="Segoe UI" FontSize="12"
										Foreground="#8FAF9F" Margin="0,4,0,0"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Orientation="Horizontal">
							<Button Style="{StaticResource OutlineBtn}" Margin="0,0,8,0"
                                    Click="AddExpense_Click">+ Add Expense</Button>
							<Button Style="{StaticResource GreenBtn}" Margin="0,0,8,0"
                                    Click="SettleUp_Click">💰 Settle Up</Button>
							<Button Style="{StaticResource RedBtn}"
                                    Click="LeaveGroup_Click">Leave Group</Button>
						</StackPanel>
					</Grid>

					<!-- Filters -->
					<Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="14,12">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<ComboBox x:Name="PeriodFilter" Grid.Column="0" Style="{StaticResource FilterCombo}"
                                      Margin="0,0,8,0" SelectionChanged="Filter_Changed">
								<ComboBoxItem Content="All Time" IsSelected="True"/>
								<ComboBoxItem Content="This Month"/>
								<ComboBoxItem Content="Last Month"/>
							</ComboBox>
							<ComboBox x:Name="CategoryFilter" Grid.Column="1" Style="{StaticResource FilterCombo}"
                                      Margin="0,0,8,0" SelectionChanged="Filter_Changed">
								<ComboBoxItem Content="All Categories" IsSelected="True"/>
							</ComboBox>
							<ComboBox x:Name="TypeFilter" Grid.Column="2" Style="{StaticResource FilterCombo}"
                                      Margin="0,0,8,0" SelectionChanged="Filter_Changed">
								<ComboBoxItem Content="All Types" IsSelected="True"/>
								<ComboBoxItem Content="Expense"/>
								<ComboBoxItem Content="Income"/>
							</ComboBox>
							<ComboBox x:Name="SortFilter" Grid.Column="3" Style="{StaticResource FilterCombo}"
                                      Margin="0,0,8,0" SelectionChanged="Filter_Changed">
								<ComboBoxItem Content="Newest First" IsSelected="True"/>
								<ComboBoxItem Content="Oldest First"/>
								<ComboBoxItem Content="Highest Amount"/>
							</ComboBox>
							<Button Grid.Column="4" Style="{StaticResource OutlineBtn}"
                                    Click="ClearFilters_Click" Padding="12,0">Clear</Button>
						</Grid>
					</Border>

					<!-- Expenses Table -->
					<Border Style="{StaticResource Card}" Padding="20,16">
						<StackPanel>
							<Border BorderBrush="#E0EDE6" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,4">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="120"/>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="90"/>
										<ColumnDefinition Width="90"/>
										<ColumnDefinition Width="80"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="Date" Foreground="#8FAF9F" FontFamily="Segoe UI Semibold" FontSize="11.5"/>
									<TextBlock Grid.Column="1" Text="Description" Foreground="#8FAF9F" FontFamily="Segoe UI Semibold" FontSize="11.5"/>
									<TextBlock Grid.Column="2" Text="Category" Foreground="#8FAF9F" FontFamily="Segoe UI Semibold" FontSize="11.5"/>
									<TextBlock Grid.Column="3" Text="Paid By" Foreground="#8FAF9F" FontFamily="Segoe UI Semibold" FontSize="11.5"/>
									<TextBlock Grid.Column="4" Text="Your Share" Foreground="#8FAF9F" FontFamily="Segoe UI Semibold" FontSize="11.5" HorizontalAlignment="Right"/>
									<TextBlock Grid.Column="5" Text="Status" Foreground="#8FAF9F" FontFamily="Segoe UI Semibold" FontSize="11.5" HorizontalAlignment="Center"/>
									<TextBlock Grid.Column="6" Text="Actions" Foreground="#8FAF9F" FontFamily="Segoe UI Semibold" FontSize="11.5" HorizontalAlignment="Center"/>
								</Grid>
							</Border>

							<ItemsControl x:Name="ExpensesTable">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border BorderBrush="#F0F6F2" BorderThickness="0,0,0,1" Padding="0,10">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="110"/>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="120"/>
													<ColumnDefinition Width="110"/>
													<ColumnDefinition Width="90"/>
													<ColumnDefinition Width="90"/>
													<ColumnDefinition Width="80"/>
												</Grid.ColumnDefinitions>
												<TextBlock Grid.Column="0" Text="{Binding DateDisplay}"
                                                           FontFamily="Segoe UI" FontSize="12" Foreground="#8FAF9F" VerticalAlignment="Center"/>
												<TextBlock Grid.Column="1" Text="{Binding Description}"
														   FontFamily="Segoe UI" FontSize="12" Foreground="#4A6558"
														   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
												<TextBlock Grid.Column="2" Text="{Binding CategoryName}"
														   FontFamily="Segoe UI" FontSize="12" Foreground="#4A6558" VerticalAlignment="Center"/>
												<TextBlock Grid.Column="3" Text="{Binding PaidBy}"
														   FontFamily="Segoe UI" FontSize="12" Foreground="#4A6558" VerticalAlignment="Center"/>
												<TextBlock Grid.Column="4" Text="{Binding AmountDisplay}"
														   FontFamily="Segoe UI Semibold" FontSize="12.5"
														   Foreground="#1A2E22" HorizontalAlignment="Right" VerticalAlignment="Center"/>
												<Border Grid.Column="5" CornerRadius="6" Padding="8,3"
														Background="{Binding StatusBg}"
														HorizontalAlignment="Center" VerticalAlignment="Center">
													<TextBlock Text="{Binding Status}"
															   FontFamily="Segoe UI Semibold" FontSize="11"
															   Foreground="{Binding StatusFg}"/>
												</Border>
												<StackPanel Grid.Column="6" Orientation="Horizontal"
															HorizontalAlignment="Center" VerticalAlignment="Center">
													<Button Tag="{Binding TransactionID}"
                                                            Background="#FFF3E0" BorderThickness="0"
                                                            Width="28" Height="28" Cursor="Hand"
                                                            ToolTip="Toggle Paid/Pending"
                                                            Click="MarkPaid_Click">
														<Button.Template>
															<ControlTemplate TargetType="Button">
																<Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
																	<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
																</Border>
																<ControlTemplate.Triggers>
																	<Trigger Property="IsMouseOver" Value="True">
																		<Setter TargetName="b" Property="Background" Value="#FFE0B2"/>
																	</Trigger>
																</ControlTemplate.Triggers>
															</ControlTemplate>
														</Button.Template>
														<TextBlock Text="✓" FontSize="13" Foreground="#E67E22"/>
													</Button>
													<Button Tag="{Binding TransactionID}"
                                                            Background="#FDECEA" BorderThickness="0"
                                                            Width="28" Height="28" Cursor="Hand"
                                                            Margin="4,0,0,0" ToolTip="Delete"
                                                            Click="DeleteExpense_Click">
														<Button.Template>
															<ControlTemplate TargetType="Button">
																<Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
																	<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
																</Border>
																<ControlTemplate.Triggers>
																	<Trigger Property="IsMouseOver" Value="True">
																		<Setter TargetName="b" Property="Background" Value="#FFCDD2"/>
																	</Trigger>
																</ControlTemplate.Triggers>
															</ControlTemplate>
														</Button.Template>
														<TextBlock Text="✕" FontSize="12" Foreground="#E74C3C"/>
													</Button>
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<StackPanel x:Name="NoExpensesPanel" Visibility="Collapsed"
                                        HorizontalAlignment="Center" Margin="0,24">
								<TextBlock Text="💸" FontSize="36" HorizontalAlignment="Center"/>
								<TextBlock Text="No expenses yet in this group"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#8FAF9F"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
							</StackPanel>

							<TextBlock x:Name="FooterCount" Text=""
                                       FontFamily="Segoe UI" FontSize="11.5" Foreground="#8FAF9F"
                                       Margin="0,12,0,0"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>

			<!-- Right: Member Balances -->
			<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,18,24,24">
				<Border Background="White" CornerRadius="14" Padding="16">
					<Border.Effect>
						<DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#1A5C38" Opacity="0.05" Direction="270"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="Group Members" FontFamily="Segoe UI Black"
								   FontSize="14" Foreground="#1A2E22" Margin="0,0,0,14"/>
						<ItemsControl x:Name="MemberBalancesList">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="#F4F8F5" CornerRadius="10"
											Padding="12,10" Margin="0,0,0,8">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="36"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>
											<Border Width="32" Height="32" CornerRadius="16" Background="#2ECC71">
												<TextBlock Text="{Binding Initial}" FontFamily="Segoe UI Semibold"
														   FontSize="14" Foreground="White"
														   HorizontalAlignment="Center" VerticalAlignment="Center"/>
											</Border>
											<StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
												<TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold"
														   FontSize="12.5" Foreground="#1A2E22"/>
												<TextBlock Text="{Binding BalanceDisplay}" FontFamily="Segoe UI Semibold"
														   FontSize="11.5" Foreground="{Binding BalanceColor}"/>
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>
			</ScrollViewer>

			<!-- Add Expense Modal -->
			<Grid Grid.ColumnSpan="2" x:Name="AddExpenseModal" Visibility="Collapsed" Background="#88000000">
				<Border MaxWidth="480" Background="White" CornerRadius="16" Padding="28"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
					<StackPanel>
						<TextBlock Text="Add Group Expense" FontFamily="Segoe UI Black"
                                   FontSize="18" Foreground="#1A2E22" Margin="0,0,0,20"/>
						<TextBlock Text="Description" FontFamily="Segoe UI Semibold"
                                   FontSize="12" Foreground="#4A6558" Margin="0,0,0,6"/>
						<TextBox x:Name="ExpenseDesc" Style="{StaticResource Input}" Margin="0,0,0,14"/>
						<TextBlock Text="Amount (€)" FontFamily="Segoe UI Semibold"
                                   FontSize="12" Foreground="#4A6558" Margin="0,0,0,6"/>
						<TextBox x:Name="ExpenseAmount" Style="{StaticResource Input}" Margin="0,0,0,14"/>
						<TextBlock Text="Category" FontFamily="Segoe UI Semibold"
                                   FontSize="12" Foreground="#4A6558" Margin="0,0,0,6"/>
						<ComboBox x:Name="ExpenseCategoryCombo" Height="40" Margin="0,0,0,14"
                                  FontFamily="Segoe UI" FontSize="13"
                                  BorderBrush="#E0EDE6" BorderThickness="1.5"/>
						<TextBlock Text="Account" FontFamily="Segoe UI Semibold"
                                   FontSize="12" Foreground="#4A6558" Margin="0,0,0,6"/>
						<ComboBox x:Name="ExpenseAccountCombo" Height="40" Margin="0,0,0,14"
                                  FontFamily="Segoe UI" FontSize="13"
                                  BorderBrush="#E0EDE6" BorderThickness="1.5"/>
						<TextBlock Text="Split Among" FontFamily="Segoe UI Semibold"
								   FontSize="12" Foreground="#4A6558" Margin="0,0,0,6"/>
						<Border BorderBrush="#E0EDE6" BorderThickness="1.5" CornerRadius="8"
								Padding="14,10" Margin="0,0,0,6" Background="#FAFAFA">
							<StackPanel>
								<StackPanel x:Name="SplitMembersPanel"/>
								<Button Content="Split equally" Click="SplitEqual_Click"
										HorizontalAlignment="Left" Margin="0,8,0,0"
										Background="Transparent" BorderThickness="0"
										Foreground="#2ECC71" FontFamily="Segoe UI Semibold"
										FontSize="12" Cursor="Hand"/>
							</StackPanel>
						</Border>
						<TextBlock x:Name="SplitValidationMsg" Foreground="#E74C3C"
								   FontSize="11" Margin="0,0,0,18" Visibility="Collapsed"/>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="10"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Button Grid.Column="0" Style="{StaticResource OutlineBtn}"
                                    Click="CancelExpense_Click">Cancel</Button>
							<Button Grid.Column="2" Style="{StaticResource GreenBtn}"
                                    Click="ConfirmExpense_Click">Add Expense</Button>
						</Grid>
					</StackPanel>
				</Border>
			</Grid>

			<!-- Settle Up Modal -->
			<Grid Grid.ColumnSpan="2" x:Name="SettleUpModal" Visibility="Collapsed" Background="#88000000">
				<Border MaxWidth="460" Background="White" CornerRadius="16" Padding="28"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
					<StackPanel>
						<TextBlock Text="💰 Settle Up" FontFamily="Segoe UI Black"
                                   FontSize="18" Foreground="#1A2E22" Margin="0,0,0,8"/>
						<TextBlock Text="Mark your pending shares as paid."
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#8FAF9F"
                                   Margin="0,0,0,20"/>
						<Border Background="#E8F5EE" CornerRadius="10" Padding="16" Margin="0,0,0,20">
							<StackPanel>
								<TextBlock Text="Your Summary" FontFamily="Segoe UI Semibold"
                                           FontSize="13" Foreground="#1A5C38" Margin="0,0,0,8"/>
								<Grid>
									<TextBlock Text="Total you owe:" FontFamily="Segoe UI" FontSize="12" Foreground="#4A6558"/>
									<TextBlock x:Name="SettlePendingAmount" Text="€0.00"
                                               FontFamily="Segoe UI Semibold" FontSize="12"
                                               Foreground="#E74C3C" HorizontalAlignment="Right"/>
								</Grid>
								<Grid Margin="0,6,0,0">
									<TextBlock Text="Pending splits:" FontFamily="Segoe UI" FontSize="12" Foreground="#4A6558"/>
									<TextBlock x:Name="SettlePendingCount" Text="0"
                                               FontFamily="Segoe UI Semibold" FontSize="12"
                                               Foreground="#1A2E22" HorizontalAlignment="Right"/>
								</Grid>
							</StackPanel>
						</Border>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="10"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Button Grid.Column="0" Style="{StaticResource OutlineBtn}"
                                    Click="CancelSettle_Click">Cancel</Button>
							<Button Grid.Column="2" Style="{StaticResource GreenBtn}"
                                    Click="ConfirmSettle_Click">Settle My Shares</Button>
						</Grid>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
