<UserControl x:Class="FinancyApplication.CategoriesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F4F6F8"
        FontFamily="Segoe UI Variable Display">

	<UserControl.Resources>
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="24"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TealButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="18,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00967A"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Category chip row (one row per category) -->
		<Style x:Key="CategoryRow" TargetType="Border">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="14,10"/>
			<Setter Property="Background" Value="#F9FAFB"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Margin" Value="0,0,0,8"/>
		</Style>
	</UserControl.Resources>

	<Grid>
		<!-- Main page content -->
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Width="980"
                        HorizontalAlignment="Center"
                        Margin="0,32,0,32">

				<!-- HEADER -->
				<Grid Margin="0,0,0,18">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel>
						<TextBlock Text="Categories"
                                   FontSize="26" FontWeight="Bold" Foreground="#1F2937"/>
						<TextBlock Text="Organize what your money is for."
                                   FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
					</StackPanel>

					<Button Grid.Column="1"
                            Content="+  Add Category"
                            Style="{StaticResource TealButton}"
                            Click="AddCategory_Click"/>
				</Grid>

				<!-- TWO CARDS SIDE BY SIDE -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- INCOME -->
					<Border Grid.Column="0" Style="{StaticResource CardStyle}">
						<StackPanel>
							<StackPanel Orientation="Horizontal" Margin="0,0,0,14">
								<Border Width="10" Height="10"
                                        Background="#00B894"
                                        CornerRadius="5"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
								<TextBlock Text="Income Categories"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>
								<TextBlock x:Name="IncomeCount"
                                           Text=" (0)"
                                           FontSize="13"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"/>
							</StackPanel>

							<ItemsControl x:Name="IncomeList">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Style="{StaticResource CategoryRow}">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>

												<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
													<TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1F2937"/>
													<Border CornerRadius="999" Padding="8,2"
                                                            Background="#E0F2F1"
                                                            Margin="10,0,0,0"
                                                            Visibility="{Binding DefaultBadgeVisibility}">
														<TextBlock Text="Default"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#00695C"/>
													</Border>
												</StackPanel>

												<StackPanel Grid.Column="1" Orientation="Horizontal">
													<Button Content="Edit"
                                                            Tag="{Binding CategoryID}"
                                                            Click="EditCategory_Click"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#00796B"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            Padding="8,4"/>
													<Button Content="Delete"
                                                            Tag="{Binding CategoryID}"
                                                            Click="DeleteCategory_Click"
                                                            IsEnabled="{Binding CanDelete}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#EF4444"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            Padding="8,4"/>
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<TextBlock x:Name="IncomeEmpty"
                                       Text="No income categories yet."
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,10"
                                       Visibility="Collapsed"/>
						</StackPanel>
					</Border>

					<!-- EXPENSE -->
					<Border Grid.Column="2" Style="{StaticResource CardStyle}">
						<StackPanel>
							<StackPanel Orientation="Horizontal" Margin="0,0,0,14">
								<Border Width="10" Height="10"
                                        Background="#EF4444"
                                        CornerRadius="5"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
								<TextBlock Text="Expense Categories"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>
								<TextBlock x:Name="ExpenseCount"
                                           Text=" (0)"
                                           FontSize="13"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"/>
							</StackPanel>

							<ItemsControl x:Name="ExpenseList">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Style="{StaticResource CategoryRow}">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>

												<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
													<TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1F2937"/>
													<Border CornerRadius="999" Padding="8,2"
                                                            Background="#E0F2F1"
                                                            Margin="10,0,0,0"
                                                            Visibility="{Binding DefaultBadgeVisibility}">
														<TextBlock Text="Default"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#00695C"/>
													</Border>
												</StackPanel>

												<StackPanel Grid.Column="1" Orientation="Horizontal">
													<Button Content="Edit"
                                                            Tag="{Binding CategoryID}"
                                                            Click="EditCategory_Click"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#00796B"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            Padding="8,4"/>
													<Button Content="Delete"
                                                            Tag="{Binding CategoryID}"
                                                            Click="DeleteCategory_Click"
                                                            IsEnabled="{Binding CanDelete}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#EF4444"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            Padding="8,4"/>
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<TextBlock x:Name="ExpenseEmpty"
                                       Text="No expense categories yet."
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,10"
                                       Visibility="Collapsed"/>
						</StackPanel>
					</Border>
				</Grid>

				<!-- HINT -->
				<TextBlock Text="Default categories can be renamed but not deleted — they keep your historical data tidy."
                           FontSize="12"
                           Foreground="#94A3B8"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"/>
			</StackPanel>
		</ScrollViewer>

		<!-- Modal overlay — hosts the Add/Edit Category form inline (no popup window) -->
		<Grid x:Name="ModalHost" Visibility="Collapsed" Background="#80000000">
			<ContentControl x:Name="ModalContent"
			                HorizontalAlignment="Center"
			                VerticalAlignment="Center"
			                Margin="0,40"/>
		</Grid>
	</Grid>
</UserControl>
