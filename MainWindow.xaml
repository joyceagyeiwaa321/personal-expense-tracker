<Window x:Class="FinancyApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Financy - Login" Height="580" Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Display">

	<Window.Resources>
		<Style x:Key="MainGreenButton" TargetType="Button">
			<Setter Property="Background" Value="#00897B"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Height" Value="50"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="#00B894"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Background" Value="#00695C"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TextButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#00897B"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Foreground" Value="#00B894"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="WinCtrlButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#888"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="Transparent" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#F0F0F0"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- FIXED: icon lives in col 0, cursor starts right after it in col 1 -->
		<Style x:Key="InputBox" TargetType="TextBox">
			<Setter Property="Height" Value="45"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="BorderBrush" Value="#DDE3E7"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Background" Value="#FAFAFA"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="38"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<ContentPresenter x:Name="IconHost"
                                                  Grid.Column="0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Tag}"/>
								<ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="#00B894"/>
								<Setter Property="Background" Value="White"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- FIXED: lock icon in col 0, text in col 1, eye button in col 2 -->
		<Style x:Key="PassBox" TargetType="PasswordBox">
			<Setter Property="Height" Value="45"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="BorderBrush" Value="#DDE3E7"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Background" Value="#FAFAFA"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="PasswordBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="38"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="32"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="🔒" FontSize="13"
                                           Foreground="#9CA3AF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
								<ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Margin="0,0,4,0"/>
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="#00B894"/>
								<Setter Property="Background" Value="White"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#374151"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Margin" Value="2,0,0,6"/>
		</Style>
	</Window.Resources>

	<Border CornerRadius="20" Background="White" ClipToBounds="True">
		<Border.Effect>
			<DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
		</Border.Effect>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.2*"/>
				<ColumnDefinition Width="1*"/>
			</Grid.ColumnDefinitions>

			<!-- LEFT PANEL -->
			<Grid Grid.Column="0" ClipToBounds="True">
				<Grid.Background>
					<LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
						<GradientStop Color="#004D40" Offset="0"/>
						<GradientStop Color="#00796B" Offset="0.5"/>
						<GradientStop Color="#004D40" Offset="1"/>
					</LinearGradientBrush>
				</Grid.Background>
				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
					<Border Width="90" Height="90" CornerRadius="22" Background="#00B894" Margin="0,0,0,20">
						<Border.Effect>
							<DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
						</Border.Effect>
						<Image Source="Images/logo.png" Height="60" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<TextBlock Text="FINANCY" FontSize="48" FontWeight="ExtraBold"
                               Foreground="White" HorizontalAlignment="Center"/>
					<TextBlock Text="Money Made Simple." FontSize="16"
                               Foreground="#B2DFDB" HorizontalAlignment="Center" Margin="0,10,0,0"/>
				</StackPanel>
			</Grid>

			<!-- RIGHT PANEL -->
			<Grid Grid.Column="1">

				<StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                            HorizontalAlignment="Right" Margin="0,14,16,0">
					<Button Content="−" Click="Minimize_Click" Style="{StaticResource WinCtrlButton}" Margin="0,0,4,0"/>
					<Button Content="□" Click="Maximize_Click" Style="{StaticResource WinCtrlButton}" Margin="0,0,4,0"/>
					<Button Content="✕" Click="Exit_Click" Style="{StaticResource WinCtrlButton}"/>
				</StackPanel>

				<Border x:Name="NotificationToast" Visibility="Collapsed"
                        VerticalAlignment="Top" Margin="40,60,40,0"
                        Background="#E0F2F1" CornerRadius="10" Padding="14,10">
					<TextBlock x:Name="NotificationText" Foreground="#004D40"
                               FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
				</Border>

				<Grid Margin="55,0">

					<!-- 1. LOGIN -->
					<StackPanel x:Name="LoginView" VerticalAlignment="Center" Visibility="Visible">
						<TextBlock Text="Welcome Back!" FontSize="28" FontWeight="Bold"
                                   Foreground="#004D40" Margin="0,0,0,4"/>
						<TextBlock Text="Sign in to your account" Foreground="#6B7280"
                                   FontSize="13" Margin="0,0,0,28"/>

						<TextBlock Text="Email Address" Style="{StaticResource FieldLabel}"/>
						<Grid Margin="0,0,0,18">
							<TextBox x:Name="EmailInput" Style="{StaticResource InputBox}">
								<TextBox.Tag>
									<TextBlock Text="✉" FontSize="14" Foreground="#9CA3AF"/>
								</TextBox.Tag>
							</TextBox>
						</Grid>

						<TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
						<Grid Margin="0,0,0,8">
							<PasswordBox x:Name="PasswordInput" Style="{StaticResource PassBox}"/>
							<TextBox x:Name="PasswordInputVisible" Style="{StaticResource InputBox}" Visibility="Collapsed">
								<TextBox.Tag>
									<TextBlock Text="🔒" FontSize="13" Foreground="#9CA3AF"/>
								</TextBox.Tag>
							</TextBox>
							<Button x:Name="LoginShowPassBtn" Content="👁" Background="Transparent"
                                    BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand"
                                    VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14"
                                    Click="LoginTogglePass_Click"/>
						</Grid>

						<Button Style="{StaticResource TextButton}" Content="Forgot Password?"
                                Click="ShowReset_Click" HorizontalAlignment="Right"
                                Margin="0,0,0,22" FontSize="12"/>
						<Button Style="{StaticResource MainGreenButton}" Content="SIGN IN"
                                Click="Login_Click" IsDefault="True"/>
						<Button Style="{StaticResource TextButton}" Content="Create an account"
                                Click="ShowRegister_Click" Margin="0,18,0,0" FontSize="13"/>
					</StackPanel>

					<!-- 2. REGISTRATION STEP 1 -->
					<StackPanel x:Name="RegisterView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Get Started" FontSize="28" FontWeight="Bold"
                                   Foreground="#004D40" Margin="0,0,0,4"/>
						<TextBlock Text="Step 1 of 3 — Create Credentials" Foreground="#6B7280"
                                   FontSize="13" Margin="0,0,0,24"/>

						<TextBlock Text="Email Address" Style="{StaticResource FieldLabel}"/>
						<Grid Margin="0,0,0,16">
							<TextBox x:Name="RegEmail" Style="{StaticResource InputBox}">
								<TextBox.Tag>
									<TextBlock Text="✉" FontSize="14" Foreground="#9CA3AF"/>
								</TextBox.Tag>
							</TextBox>
						</Grid>

						<TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
						<Grid Margin="0,0,0,6">
							<PasswordBox x:Name="RegPass" Style="{StaticResource PassBox}"
                                         PasswordChanged="RegPass_PasswordChanged"/>
							<TextBox x:Name="RegPassVisible" Style="{StaticResource InputBox}"
                                     Visibility="Collapsed" TextChanged="RegPassVisible_TextChanged">
								<TextBox.Tag>
									<TextBlock Text="🔒" FontSize="13" Foreground="#9CA3AF"/>
								</TextBox.Tag>
							</TextBox>
							<Button Content="👁" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Right" Cursor="Hand"
                                    VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14"
                                    Click="RegTogglePass_Click"/>
						</Grid>

						<StackPanel Margin="0,0,0,4">
							<ProgressBar x:Name="StrengthBar" Height="4" Minimum="0" Maximum="4"
                                         Value="0" Background="#E5E7EB" Margin="0,0,0,4">
								<ProgressBar.Template>
									<ControlTemplate TargetType="ProgressBar">
										<Border CornerRadius="2" Background="{TemplateBinding Background}">
											<Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                    CornerRadius="2" Background="#00B894"/>
										</Border>
									</ControlTemplate>
								</ProgressBar.Template>
							</ProgressBar>
							<TextBlock x:Name="StrengthLabel" FontSize="11" Foreground="#6B7280"/>
						</StackPanel>

						<TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}" Margin="2,10,0,6"/>
						<Grid Margin="0,0,0,20">
							<PasswordBox x:Name="RegConfirmPass" Style="{StaticResource PassBox}"/>
							<TextBox x:Name="RegConfirmPassVisible" Style="{StaticResource InputBox}"
                                     Visibility="Collapsed">
								<TextBox.Tag>
									<TextBlock Text="🔒" FontSize="13" Foreground="#9CA3AF"/>
								</TextBox.Tag>
							</TextBox>
							<Button Content="👁" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Right" Cursor="Hand"
                                    VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14"
                                    Click="RegToggleConfirmPass_Click"/>
						</Grid>

						<Button Style="{StaticResource MainGreenButton}" Content="CONTINUE"
                                Click="RegisterStep1_Click" IsDefault="True"/>
						<Button Style="{StaticResource TextButton}" Content="Back to Login"
                                Click="ShowLogin_Click" Margin="0,16,0,0" FontSize="13"/>
					</StackPanel>

					<!-- 3. REGISTRATION STEP 2 (VERIFY) -->
					<StackPanel x:Name="RegVerifyView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Check Your Email" FontSize="28" FontWeight="Bold"
                                   Foreground="#004D40" Margin="0,0,0,4"/>
						<TextBlock Text="Step 2 of 3 — Enter verification code" Foreground="#6B7280"
                                   FontSize="13" Margin="0,0,0,28"/>
						<TextBox x:Name="RegCodeInput" Height="55" Margin="0,0,0,22"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 FontSize="26" FontWeight="Bold" MaxLength="6"
                                 Style="{StaticResource InputBox}" Padding="0"/>
						<Button Style="{StaticResource MainGreenButton}" Content="VERIFY EMAIL"
                                Click="RegisterStep2_Click" IsDefault="True"/>
						<Button x:Name="RegResendBtn" Style="{StaticResource TextButton}"
                                Content="Resend Code" Click="RegisterStep1_Click" Margin="0,14,0,0"/>
						<TextBlock x:Name="RegTimerText" HorizontalAlignment="Center"
                                   Margin="0,4,0,0" Foreground="#9CA3AF" Visibility="Collapsed" FontSize="12"/>
						<Button Style="{StaticResource TextButton}" Content="Back"
                                Click="ShowRegister_Click" Margin="0,12,0,0" FontSize="13"/>
					</StackPanel>

					<!-- 4. REGISTRATION STEP 3 (USERNAME) -->
					<StackPanel x:Name="RegUsernameView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Almost Done!" FontSize="28" FontWeight="Bold"
                                   Foreground="#004D40" Margin="0,0,0,4"/>
						<TextBlock Text="Step 3 of 3 — Choose your username" Foreground="#6B7280"
                                   FontSize="13" Margin="0,0,0,28"/>
						<TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
						<Grid Margin="0,0,0,26">
							<TextBox x:Name="RegUsername" Style="{StaticResource InputBox}">
								<TextBox.Tag>
									<TextBlock Text="👤" FontSize="13" Foreground="#9CA3AF"/>
								</TextBox.Tag>
							</TextBox>
						</Grid>
						<Button Style="{StaticResource MainGreenButton}" Content="FINISH SIGNUP"
                                Click="RegisterStep3_Click" IsDefault="True"/>
						<Button Style="{StaticResource TextButton}" Content="Back"
                                Click="RegisterStep2_Back_Click" Margin="0,14,0,0" FontSize="13"/>
					</StackPanel>

					<!-- 5. PASSWORD RESET: EMAIL -->
					<StackPanel x:Name="ResetView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Reset Password" FontSize="28" FontWeight="Bold"
                                   Foreground="#004D40" Margin="0,0,0,4"/>
						<TextBlock Text="Enter your email to receive a reset code"
                                   Foreground="#6B7280" FontSize="13" Margin="0,0,0,24"/>
						<TextBlock Text="Email Address" Style="{StaticResource FieldLabel}"/>
						<Grid Margin="0,0,0,20">
							<TextBox x:Name="ResetEmailInput" Style="{StaticResource InputBox}">
								<TextBox.Tag>
									<TextBlock Text="✉" FontSize="14" Foreground="#9CA3AF"/>
								</TextBox.Tag>
							</TextBox>
						</Grid>
						<Button Style="{StaticResource MainGreenButton}" Content="SEND RESET CODE"
                                Click="SendReset_Click" IsDefault="True"/>
						<Button Style="{StaticResource TextButton}" Content="Back to Sign In"
                                Click="ShowLogin_Click" Margin="0,16,0,0" FontSize="13"/>
					</StackPanel>

					<!-- 6. PASSWORD RESET: CODE VERIFY -->
					<StackPanel x:Name="VerifyView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Verify Code" FontSize="28" FontWeight="Bold"
                                   Foreground="#004D40" Margin="0,0,0,4"/>
						<TextBlock Text="Enter the 6-digit code sent to your email"
                                   Foreground="#6B7280" FontSize="13" Margin="0,0,0,24"/>
						<TextBox x:Name="CodeInput" Height="55" Margin="0,0,0,22"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 FontSize="26" FontWeight="Bold" MaxLength="6"
                                 Style="{StaticResource InputBox}" Padding="0"/>
						<Button Style="{StaticResource MainGreenButton}" Content="VERIFY"
                                Click="VerifyCode_Click" IsDefault="True"/>
						<Button x:Name="SendCodeBtn" Style="{StaticResource TextButton}"
                                Content="Resend Code" Click="SendReset_Click" Margin="0,14,0,0"/>
						<TextBlock x:Name="TimerText" HorizontalAlignment="Center"
                                   Margin="0,4,0,0" Foreground="#9CA3AF" Visibility="Collapsed" FontSize="12"/>
						<Button Style="{StaticResource TextButton}" Content="Back"
                                Click="ShowReset_Click" Margin="0,12,0,0" FontSize="13"/>
					</StackPanel>

					<!-- 7. PASSWORD RESET: NEW PASSWORD -->
					<StackPanel x:Name="NewPasswordView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Set New Password" FontSize="28" FontWeight="Bold"
                                   Foreground="#004D40" Margin="0,0,0,26"/>
						<TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
						<Grid Margin="0,0,0,16">
							<PasswordBox x:Name="NewPass" Style="{StaticResource PassBox}"/>
						</Grid>
						<TextBlock Text="Confirm New Password" Style="{StaticResource FieldLabel}"/>
						<Grid Margin="0,0,0,26">
							<PasswordBox x:Name="RepeatPass" Style="{StaticResource PassBox}"/>
						</Grid>
						<Button Style="{StaticResource MainGreenButton}" Content="UPDATE PASSWORD"
                                Click="FinalReset_Click" IsDefault="True"/>
					</StackPanel>

				</Grid>
			</Grid>
		</Grid>
	</Border>
</Window>
