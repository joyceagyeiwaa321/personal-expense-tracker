<Window x:Class="FinancyApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Financy - Login" Height="550" Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Display">

	<Window.Resources>
		<!-- Style for the Solid Green Buttons -->
		<Style x:Key="MainGreenButton" TargetType="Button">
			<Setter Property="Background" Value="#1B5E20"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Height" Value="50"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="#2E7D32"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Background" Value="#0A4310"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Style for Text-only Buttons -->
		<Style x:Key="TextButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#1B5E20"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Foreground" Value="#43A047"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border CornerRadius="25" Background="White" ClipToBounds="True">
		<Border.Effect>
			<DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
		</Border.Effect>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.3*"/>
				<ColumnDefinition Width="1*"/>
			</Grid.ColumnDefinitions>

			<!-- LEFT PANEL: BRANDING -->
			<Grid Grid.Column="0">
				<Grid.Background>
					<LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
						<GradientStop Color="#0A4310" Offset="0"/>
						<GradientStop Color="#1B5E20" Offset="1"/>
					</LinearGradientBrush>
				</Grid.Background>

				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
					<Image Source="Images/logo.png" Height="200" Margin="0,0,0,20"/>
					<TextBlock Text="FINANCY" FontSize="52" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
					<TextBlock Text="Money Made Simple." FontSize="18" Foreground="#C8E6C9" HorizontalAlignment="Center" Margin="0,10,0,0"/>
				</StackPanel>
			</Grid>

			<!-- RIGHT PANEL: INTERFACE -->
			<Grid Grid.Column="1">
				<!-- WINDOW CONTROLS -->
				<StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,25,0">
					<Button Content="▢" Click="Maximize_Click" Width="30" Height="30" Style="{StaticResource TextButton}" Foreground="Gray" FontSize="18" Margin="0,0,10,0"/>
					<Button Content="✕" Click="Exit_Click" Width="30" Height="30" Style="{StaticResource TextButton}" Foreground="Gray" FontSize="18"/>
				</StackPanel>

				<!-- NOTIFICATION SYSTEM -->
				<Border x:Name="NotificationToast" Visibility="Collapsed" VerticalAlignment="Top" Margin="40,60,40,0" Background="#E8F5E9" CornerRadius="12" Padding="15,10">
					<TextBlock x:Name="NotificationText" Foreground="#1B5E20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
				</Border>

				<Grid Margin="60,0">
					<!-- 1. LOGIN VIEW -->
					<StackPanel x:Name="LoginView" VerticalAlignment="Center" Visibility="Visible">
						<TextBlock Text="Welcome Back" FontSize="32" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,5"/>
						<TextBlock Text="Sign in to your account" Foreground="Gray" Margin="0,0,0,35"/>
						<TextBlock Text="Email Address" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8"/>
						<TextBox x:Name="EmailInput" Height="45" Margin="0,0,0,20" VerticalContentAlignment="Center" Padding="12,0"/>
						<TextBlock Text="Password" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8"/>
						<PasswordBox x:Name="PasswordInput" Height="45" Margin="0,0,0,10" VerticalContentAlignment="Center" Padding="12,0"/>
						<Button Style="{StaticResource TextButton}" Content="Forgot Password?" Click="ShowReset_Click" HorizontalAlignment="Right" Margin="0,0,0,25"/>
						<Button Style="{StaticResource MainGreenButton}" Content="SIGN IN" Click="Login_Click" IsDefault="True"/>
						<Button Style="{StaticResource TextButton}" Content="Create an account" Click="ShowRegister_Click" Margin="0,20,0,0" FontSize="14"/>
					</StackPanel>

					<!-- 2. REGISTRATION STEP 1 -->
					<StackPanel x:Name="RegisterView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Get Started" FontSize="32" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,5"/>
						<TextBlock Text="Step 1 of 3: Create Credentials" Foreground="Gray" Margin="0,0,0,30"/>
						<TextBlock Text="Email Address" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8"/>
						<TextBox x:Name="RegEmail" Height="45" Margin="0,0,0,20" VerticalContentAlignment="Center" Padding="12,0"/>
						<TextBlock Text="Password" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8"/>
						<PasswordBox x:Name="RegPass" Height="45" Margin="0,0,0,30" VerticalContentAlignment="Center" Padding="12,0"/>
						<Button Style="{StaticResource MainGreenButton}" Content="CONTINUE" Click="RegisterStep1_Click" IsDefault="True"/>
						<Button Style="{StaticResource TextButton}" Content="Back to Login" Click="ShowLogin_Click" Margin="0,20,0,0"/>
					</StackPanel>

					<!-- 3. REGISTRATION STEP 2 (VERIFY) -->
					<StackPanel x:Name="RegVerifyView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Check Email" FontSize="32" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,5"/>
						<TextBlock Text="Step 2 of 3: Enter verification code" Foreground="Gray" Margin="0,0,0,30"/>
						<TextBox x:Name="RegCodeInput" Height="55" Margin="0,0,0,25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="24" FontWeight="Bold" MaxLength="6"/>
						<Button Style="{StaticResource MainGreenButton}" Content="VERIFY EMAIL" Click="RegisterStep2_Click" IsDefault="True"/>
						<Button x:Name="RegResendBtn" Style="{StaticResource TextButton}" Content="Resend Code" Click="RegisterStep1_Click" Margin="0,15,0,0"/>
						<TextBlock x:Name="RegTimerText" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="Gray" Visibility="Collapsed" FontSize="12"/>
						<Button Style="{StaticResource TextButton}" Content="Back" Click="ShowRegister_Click" Margin="0,15,0,0"/>
					</StackPanel>

					<!-- 4. REGISTRATION STEP 3 (USERNAME) -->
					<StackPanel x:Name="RegUsernameView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Almost Done" FontSize="32" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,5"/>
						<TextBlock Text="Step 3 of 3: Choose your username" Foreground="Gray" Margin="0,0,0,30"/>
						<TextBlock Text="Username" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8"/>
						<TextBox x:Name="RegUsername" Height="45" Margin="0,0,0,30" VerticalContentAlignment="Center" Padding="12,0"/>
						<Button Style="{StaticResource MainGreenButton}" Content="FINISH SIGNUP" Click="RegisterStep3_Click" IsDefault="True"/>
						<Button Style="{StaticResource TextButton}" Content="Back" Click="RegisterStep2_Back_Click" Margin="0,15,0,0"/>
					</StackPanel>

					<!-- 5. PASSWORD RESET: EMAIL -->
					<StackPanel x:Name="ResetView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Reset Password" FontSize="32" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,10"/>
						<TextBlock Text="Enter email for reset code" Foreground="Gray" Margin="0,0,0,25"/>
						<TextBox x:Name="ResetEmailInput" Height="45" Margin="0,0,0,20" VerticalContentAlignment="Center" Padding="12,0"/>
						<Button Style="{StaticResource MainGreenButton}" Content="SEND RESET CODE" Click="SendReset_Click" IsDefault="True"/>
						<Button Style="{StaticResource TextButton}" Content="Back to Sign In" Click="ShowLogin_Click" Margin="0,20,0,0"/>
					</StackPanel>

					<!-- 6. PASSWORD RESET: CODE VERIFY -->
					<StackPanel x:Name="VerifyView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Verify Code" FontSize="32" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,10"/>
						<TextBox x:Name="CodeInput" Height="55" Margin="0,0,0,25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="24" FontWeight="Bold" MaxLength="6"/>
						<Button Style="{StaticResource MainGreenButton}" Content="VERIFY" Click="VerifyCode_Click" IsDefault="True"/>
						<Button x:Name="SendCodeBtn" Style="{StaticResource TextButton}" Content="Resend Code" Click="SendReset_Click" Margin="0,15,0,0"/>
						<!-- THE MISSING ELEMENT THAT CAUSED YOUR ERROR: -->
						<TextBlock x:Name="TimerText" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="Gray" Visibility="Collapsed" FontSize="12"/>
						<Button Style="{StaticResource TextButton}" Content="Back" Click="ShowReset_Click" Margin="0,15,0,0"/>
					</StackPanel>

					<!-- 7. PASSWORD RESET: NEW PASSWORD -->
					<StackPanel x:Name="NewPasswordView" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="Set New Password" FontSize="32" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,30"/>
						<TextBlock Text="New Password" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8"/>
						<PasswordBox x:Name="NewPass" Height="45" Margin="0,0,0,20" VerticalContentAlignment="Center" Padding="12,0"/>
						<TextBlock Text="Confirm Password" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8"/>
						<PasswordBox x:Name="RepeatPass" Height="45" Margin="0,0,0,30" VerticalContentAlignment="Center" Padding="12,0"/>
						<Button Style="{StaticResource MainGreenButton}" Content="UPDATE PASSWORD" Click="FinalReset_Click" IsDefault="True"/>
					</StackPanel>
				</Grid>
			</Grid>
		</Grid>
	</Border>
</Window>