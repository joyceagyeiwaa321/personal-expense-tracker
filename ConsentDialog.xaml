<Window x:Class="FinancyApplication.ConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Financy"
        Width="520"
        Height="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

	<Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="14"
            Padding="32">
		<Border.Effect>
			<DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.30"/>
		</Border.Effect>

		<StackPanel>
			<TextBlock Text="Welcome to Financy Application"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
			<TextBlock Text="Before you start, a quick heads-up:"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,6,0,18"/>

			<TextBlock TextWrapping="Wrap"
                       LineHeight="22"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"><Run Text="This is a student project. Your data"/><Run Language="en-gb" Text=","/><Run Text=" transactions, budgets, accounts stays on your computer in your local MySQL database. We don't collect anything, and your password is stored hashed."/></TextBlock>

			<TextBlock TextWrapping="Wrap"
                       LineHeight="22"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,12,0,0">
                If you later enable optional AI features (insights, receipt scan), those send only the specific data
                you trigger them with — never your name, email, or full transaction history.
			</TextBlock>

			<TextBlock TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,18,0,22">
                By clicking Accept, you acknowledge this and agree to use the app at your own discretion.
			</TextBlock>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Decline &amp; Exit"
                        Width="130" Height="36"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        FontSize="13"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="Decline_Click"/>
				<Button Content="Accept &amp; Continue"
                        Width="160" Height="36"
                        Background="{DynamicResource AccentBrush}"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Accept_Click"/>
			</StackPanel>
		</StackPanel>
	</Border>
</Window>