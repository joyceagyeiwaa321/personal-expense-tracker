<Window x:Class="FinancyApplication.GoalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Goal"
        Width="480"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8">

	<Window.Resources>
		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#374151"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
		</Style>

		<Style x:Key="InputBox" TargetType="TextBox">
			<Setter Property="Height" Value="36"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="BorderBrush" Value="#DDE3E7"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Margin" Value="0,0,0,14"/>
			<Style.Triggers>
				<Trigger Property="IsFocused" Value="True">
					<Setter Property="BorderBrush" Value="#00B894"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="GreenButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="16,0">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00967A"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border Background="White" CornerRadius="10" Margin="16">
		<Border.Effect>
			<DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10"/>
		</Border.Effect>

		<StackPanel Margin="28,24">

			<TextBlock x:Name="DialogTitle"
                       Text="Add New Goal"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#1F2937"
                       Margin="0,0,0,20"/>

			<!-- Goal Name -->
			<TextBlock Text="Goal Name" Style="{StaticResource FieldLabel}"/>
			<TextBox x:Name="NameInput" Style="{StaticResource InputBox}"/>

			<!-- Target Amount -->
			<TextBlock Text="Target Amount (€)" Style="{StaticResource FieldLabel}"/>
			<TextBox x:Name="TargetInput" Style="{StaticResource InputBox}"/>

			<!-- Saved Amount -->
			<TextBlock Text="Saved So Far (€)" Style="{StaticResource FieldLabel}"/>
			<TextBox x:Name="SavedInput" Style="{StaticResource InputBox}"/>

			<!-- Deadline -->
			<TextBlock Text="Deadline (optional)" Style="{StaticResource FieldLabel}"/>
			<DatePicker x:Name="DeadlinePicker"
                        Height="36"
                        FontSize="13"
                        Margin="0,0,0,20"/>

			<!-- Buttons -->
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="12"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0"
                        Content="Cancel"
                        Height="40"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderThickness="0"
                        FontSize="13"
                        Cursor="Hand"
                        Click="Cancel_Click">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="bg" Property="Background" Value="#E5E7EB"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>

				<Button Grid.Column="2"
                        x:Name="SaveButton"
                        Content="Save Goal"
                        Style="{StaticResource GreenButton}"
                        Click="Save_Click"/>
			</Grid>

		</StackPanel>
	</Border>
</Window>
