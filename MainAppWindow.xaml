<Window x:Class="FinancyApplication.MainAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Financy"
        Height="760" Width="1260"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

	<Window.Resources>
		<SolidColorBrush x:Key="GreenDark"   Color="#1A5C38"/>
		<SolidColorBrush x:Key="GreenAccent" Color="#2ECC71"/>

		<Style x:Key="NavBtn" TargetType="Button">
			<Setter Property="Background"              Value="Transparent"/>
			<Setter Property="Foreground"              Value="#CCFFD9"/>
			<Setter Property="BorderThickness"         Value="0"/>
			<Setter Property="Height"                  Value="44"/>
			<Setter Property="Cursor"                  Value="Hand"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="FontFamily"              Value="Segoe UI"/>
			<Setter Property="FontSize"                Value="13.5"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="nb" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="8,1">
							<ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="16,0,0,0"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="nb" Property="Background" Value="#2A7A4A"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
			<Setter Property="Background" Value="#2ECC71"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		<Style x:Key="WinBtn" TargetType="Button">
			<Setter Property="Width"           Value="28"/>
			<Setter Property="Height"          Value="28"/>
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground"      Value="#AACCBB"/>
			<Setter Property="FontSize"        Value="13"/>
			<Setter Property="Cursor"          Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border CornerRadius="16" ClipToBounds="True">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="220"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- ══════════ SIDEBAR ══════════ -->
			<Border Grid.Column="0" Background="#1A5C38">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<!-- Logo -->
					<StackPanel Grid.Row="0" Margin="20,24,20,14">
						<Image Source="Images/logo.png" Height="36" HorizontalAlignment="Left"
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,6"/>
						<TextBlock Text="FINANCY" Foreground="White"
                                   FontFamily="Segoe UI Black" FontSize="20" />
						<TextBlock Text="Money Made Simple." Foreground="#88CCAA"
                                   FontFamily="Segoe UI" FontSize="10.5" Margin="0,2,0,0"/>
					</StackPanel>
					<Rectangle Grid.Row="0" Height="1" Fill="#2A7A4A"
                               VerticalAlignment="Bottom" Margin="16,0"/>

					<!-- Nav -->
					<StackPanel Grid.Row="1" Margin="0,10,0,0">
						<TextBlock Text="MAIN MENU" Foreground="#557766"
                                   FontFamily="Segoe UI" FontSize="9" FontWeight="Bold"
                                   Margin="24,8,0,4" />

						<Button x:Name="NavDashboard"    Style="{StaticResource NavBtnActive}" Click="Nav_Click" Tag="Dashboard">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="🏠" FontSize="14" Margin="0,0,10,0"/>
								<TextBlock Text="Dashboard" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="NavTransactions" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Transactions">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="↕" FontSize="16" Margin="0,0,10,0" Opacity="0.7"/>
								<TextBlock Text="Transactions" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="NavAccounts"     Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Accounts">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="🏦" FontSize="14" Margin="0,0,10,0"/>
								<TextBlock Text="Accounts" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="NavBudget"       Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Budget">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="📊" FontSize="14" Margin="0,0,10,0"/>
								<TextBlock Text="Budget" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="NavRecurring"    Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Recurring">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="🔁" FontSize="14" Margin="0,0,10,0"/>
								<TextBlock Text="Recurring" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="NavGroups"       Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Groups">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="👥" FontSize="14" Margin="0,0,10,0"/>
								<TextBlock Text="Groups" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<TextBlock Text="SETTINGS" Foreground="#557766"
                                   FontFamily="Segoe UI" FontSize="9" FontWeight="Bold"
                                   Margin="24,14,0,4" />

						<Button x:Name="NavProfile"      Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Profile">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="👤" FontSize="14" Margin="0,0,10,0"/>
								<TextBlock Text="My Profile" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="NavReports"      Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Reports">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="📈" FontSize="14" Margin="0,0,10,0"/>
								<TextBlock Text="Reports" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</StackPanel>

					<!-- User strip -->
					<Border Grid.Row="2" Padding="14,12"
                            BorderBrush="#2A7A4A" BorderThickness="0,1,0,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Border Width="36" Height="36" CornerRadius="18" Background="#2ECC71">
								<TextBlock x:Name="AvatarInitial" Text="U" Foreground="White"
                                           FontSize="14" FontFamily="Segoe UI Semibold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
								<TextBlock x:Name="SidebarUsername" Text="User"
                                           Foreground="White" FontFamily="Segoe UI Semibold" FontSize="12.5"/>
								<TextBlock x:Name="SidebarEmail" Text=""
                                           Foreground="#88AAAA" FontFamily="Segoe UI" FontSize="10.5"/>
							</StackPanel>
							<Button Grid.Column="2" Style="{StaticResource WinBtn}"
                                    ToolTip="Sign Out" Click="SignOut_Click">
								<TextBlock Text="⏏" FontSize="13"/>
							</Button>
						</Grid>
					</Border>
				</Grid>
			</Border>

			<!-- ══════════ MAIN CONTENT AREA ══════════ -->
			<Grid Grid.Column="1" Background="#F4F8F5">
				<Grid.RowDefinitions>
					<RowDefinition Height="54"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- Top bar -->
				<Border Grid.Row="0" Background="White"
                        BorderBrush="#E0EDE6" BorderThickness="0,0,0,1">
					<Grid Margin="24,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="PageTitle" Text="Dashboard"
                                   FontFamily="Segoe UI Semibold" FontSize="15"
                                   Foreground="#1A2E22" VerticalAlignment="Center"/>
						<StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" >
							<TextBlock x:Name="TopDate" FontFamily="Segoe UI"
                                       FontSize="11.5" Foreground="#8FAF9F"
                                       VerticalAlignment="Center"/>
							<Button Style="{StaticResource WinBtn}" Foreground="#8FAF9F"
                                    Click="Maximize_Click">
								<TextBlock Text="⬜" FontSize="11"/>
							</Button>
							<Button Style="{StaticResource WinBtn}" Foreground="#FF6B6B"
                                    Click="Exit_Click">
								<TextBlock Text="✕" FontSize="11"/>
							</Button>
						</StackPanel>
					</Grid>
				</Border>

				<!-- Page content swaps here -->
				<ContentControl x:Name="PageHost" Grid.Row="1"/>
			</Grid>
		</Grid>
	</Border>
</Window>
