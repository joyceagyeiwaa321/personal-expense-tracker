<UserControl x:Class="FinancyApplication.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F8"
             FontFamily="Segoe UI Variable Display">

	<UserControl.Resources>
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="22"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TealButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="18,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00967A"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="ChipBorder" TargetType="Border">
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
		</Style>
	</UserControl.Resources>

	<Grid>
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Width="900"
                        HorizontalAlignment="Center"
                        Margin="0,32,0,32">

				<!-- HEADER -->
				<Grid Margin="0,0,0,18">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel>
						<TextBlock Text="Accounts"
                                   FontSize="26" FontWeight="Bold" Foreground="#1F2937"/>
						<TextBlock Text="Your wallets, cards, and balances."
                                   FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
					</StackPanel>

					<Button Grid.Column="1"
                            Content="+  Add Account"
                            Style="{StaticResource TealButton}"
                            Click="AddAccount_Click"/>
				</Grid>

				<!-- LIST -->
				<ItemsControl x:Name="AccountList">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<StackPanel>
										<TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"/>
										<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
											<Border Style="{StaticResource ChipBorder}"
                                                    Background="#E0F2F1"
                                                    Margin="0,0,8,0">
												<TextBlock Text="{Binding AccountType}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#00695C"/>
											</Border>
											<TextBlock Text="{Binding Currency}"
                                                       FontSize="12"
                                                       Foreground="#64748B"
                                                       VerticalAlignment="Center"/>
										</StackPanel>
									</StackPanel>

									<TextBlock Grid.Column="1"
                                               Text="{Binding BalanceDisplay}"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               Foreground="#1F2937"
                                               VerticalAlignment="Center"
                                               Margin="20,0"/>

									<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
										<Button Content="Rename"
                                                Tag="{Binding AccountID}"
                                                Click="EditAccount_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#00796B"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Padding="10,6"/>
										<Button Content="Delete"
                                                Tag="{Binding AccountID}"
                                                Click="DeleteAccount_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#EF4444"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Padding="10,6"/>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- EMPTY STATE -->
				<Border x:Name="EmptyState" Style="{StaticResource CardStyle}" Visibility="Collapsed">
					<StackPanel HorizontalAlignment="Center" Margin="0,30">
						<TextBlock Text="No accounts yet."
                                   FontSize="14"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"/>
						<TextBlock Text="Click + Add Account to create your first one."
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<!-- Modal overlay for Add/Edit Account form -->
		<Grid x:Name="ModalHost" Visibility="Collapsed" Background="#80000000">
			<ContentControl x:Name="ModalContent"
			                HorizontalAlignment="Center"
			                VerticalAlignment="Center"
			                Margin="0,40"/>
		</Grid>
	</Grid>
</UserControl>
