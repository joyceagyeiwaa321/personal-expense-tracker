<UserControl x:Class="FinancyApplication.AccountDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI Variable Display"
             Width="460"
             MaxHeight="640">

	<UserControl.Resources>
		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#374151"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
		</Style>

		<Style x:Key="GreenButton" TargetType="Button">
			<Setter Property="Background" Value="#00B894"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="16,0">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#00967A"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GrayButton" TargetType="Button">
			<Setter Property="Background" Value="#F1F5F9"/>
			<Setter Property="Foreground" Value="#374151"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="16,0">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="TextBox">
			<Setter Property="Height" Value="38"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1.5"/>
		</Style>

		<Style TargetType="ComboBox">
			<Setter Property="Height" Value="38"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
	</UserControl.Resources>

	<Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
		<Border.Effect>
			<DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18"/>
		</Border.Effect>

		<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
			<StackPanel Margin="28,24,28,24">

				<TextBlock x:Name="DialogTitle"
                           Text="Add Account"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,20"/>

				<TextBlock Text="Account Name" Style="{StaticResource FieldLabel}"/>
				<TextBox x:Name="NameInput" Margin="0,0,0,14"/>

				<!-- These three are only visible in Add mode; collapsed for renaming. -->
				<StackPanel x:Name="AddOnlyFields">
					<TextBlock Text="Account Type" Style="{StaticResource FieldLabel}"/>
					<ComboBox x:Name="AccountTypeCombo" Margin="0,0,0,14" SelectedIndex="0">
						<ComboBoxItem Content="Checking"/>
						<ComboBoxItem Content="Savings"/>
						<ComboBoxItem Content="Credit Card"/>
						<ComboBoxItem Content="Cash"/>
						<ComboBoxItem Content="Other"/>
					</ComboBox>

					<TextBlock Text="Initial Balance" Style="{StaticResource FieldLabel}"/>
					<TextBox x:Name="BalanceInput" Margin="0,0,0,14" Text="0"/>

					<TextBlock Text="Currency" Style="{StaticResource FieldLabel}"/>
					<ComboBox x:Name="CurrencyCombo" Margin="0,0,0,22"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
					<Button Content="Cancel"
                            Style="{StaticResource GrayButton}"
                            Width="100"
                            Margin="0,0,10,0"
                            Click="Cancel_Click"/>
					<Button x:Name="SaveButton"
                            Content="Save Account"
                            Style="{StaticResource GreenButton}"
                            Width="160"
                            Click="Save_Click"/>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Border>
</UserControl>
